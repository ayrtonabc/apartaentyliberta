# ─────────────────────────────────────────────────────────────────────────────
# Apartamenty Liberta — variables de entorno
#
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# `.env` NO se versiona. Lo lee `astro dev`, el servidor de producción
# (`server.mjs`, al arrancar) y los scripts de mantenimiento.
#
# No hay valores duplicados a propósito: lo que el código no lee, no se declara
# aquí. (Antes había TURNSTILE_*, PUBLIC_GA4_MEASUREMENT_ID y SENTRY_DSN, que
# ninguna línea del proyecto usa: daban a entender una protección antispam y un
# sistema de analítica que no existen.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Email de reservas (Resend) ───────────────────────────────────────────────
# OBLIGATORIA en producción. Sin ella el formulario sigue respondiendo 200 y la
# solicitud se escribe en el log del servidor, pero NADIE recibe el correo.
# Se lee en tiempo de ejecución: se puede poner después de compilar.
RESEND_API_KEY=

# Destino de los avisos de reserva. Por defecto, site.email (src/data/site.ts).
OWNER_EMAIL=kontakt@apartamentyliberta.pl

# Remitente. El dominio debe estar verificado en Resend (SPF/DKIM).
BOOKING_FROM_EMAIL=noreply@apartamentyliberta.pl

# ── Disponibilidad ──────────────────────────────────────────────────────────
# iCal de Booking.com (Property → Calendar → Export calendar). Solo lo usa
# `npm run availability:update`; no hace falta en el servidor web.
BOOKING_ICAL_URL=

# JSON que lee el servidor. Vacío = src/data/availability.json.
# En el VPS conviene un volumen actualizado por cron:
#   AVAILABILITY_FILE=/srv/liberta-data/availability.json
AVAILABILITY_FILE=

# ── Servidor de producción (server.mjs) ─────────────────────────────────────
PORT=8080
HOST=0.0.0.0

{
  "name": "apartamenty-liberta-new",
  "type": "module",
  "version": "1.0.0",
  "description": "Nueva experiencia digital para Apartamenty Liberta. Astro + i18n + SEO optimizado.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "astro build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "postbuild": "node scripts/compress-dist.mjs && node scripts/prune-dist.mjs",
    "start": "node ./server.mjs",
    "preview": "node ./server.mjs",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "images:download": "node scripts/download-images.mjs",
    "images:download:ps": "powershell -ExecutionPolicy Bypass -File scripts/download-images.ps1",
    "images:responsive": "node scripts/responsive-images.mjs",
    "images:import": "node scripts/import-new-photos.mjs",
    "images:posters": "node scripts/import-video-posters.mjs",
    "images:wellness": "node scripts/import-wellness-photos.mjs",
    "rename:hero": "node scripts/rename-hero-images.mjs",
    "compress": "node scripts/compress-dist.mjs",
    "prune": "node scripts/prune-dist.mjs",
    "test:structure": "node tests/validate-structure.mjs",
    "test:syntax": "node tests/validate-syntax.mjs",
    "test:routes": "node tests/validate-routes.mjs",
    "test:images": "node tests/validate-images.mjs",
    "test": "npm run test:structure && npm run test:syntax && npm run test:routes && npm run test:images",
    "clean": "node scripts/clean-caches.mjs",
    "fresh": "node scripts/clean-caches.mjs && astro dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^6.4.8",
    "astro-compress": "^2.2.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^10.1.4",
    "@astrojs/vercel": "^10.0.8",
    "@types/node": "^22.9.0",
    "typescript": "^5.9.3"
  }
}

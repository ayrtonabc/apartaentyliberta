---
/**
 * Testimonials — sección de opiniones de la portada.
 *
 * Dos cintas continuas, una por plataforma, con las reseñas reales y el
 * logotipo de su origen. El objetivo es que la prueba social se lea como parte
 * del producto, no como un widget pegado: tipografía editorial, tarjetas con
 * el comentario completo desplegable y un resumen de las dos notas separadas.
 *
 * No se inventan fechas, países ni estancias: la tarjeta solo lleva nombre,
 * estrellas, comentario y plataforma.
 */
import { type Locale, getLocaleFromUrl, localeLink, t } from "~/lib/i18n";
import { aggregateRatings, getTotalReviews, reviewsForLocale } from "~/data/reviews";
import Icon from "~/components/ui/Icon.astro";
import ReviewLogo from "~/components/ui/ReviewLogo.astro";
import ReviewStars from "~/components/ui/ReviewStars.astro";
import TestimonialCard from "~/components/content/TestimonialCard.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);
const total = getTotalReviews();

const all = reviewsForLocale(locale);

/**
 * Selección para las cintas.
 *
 * No se pintan las 121 tarjetas: duplicarlas para el bucle dejaría 240 nodos y
 * un HTML enorme. Se eligen las reseñas con texto suficiente y buena nota; el
 * resto sigue disponible en /opinie/.
 */
const googleReviews = all
  .filter((review) => review.source === "google" && review.rating >= 4 && review.text.trim().length > 45)
  .slice(0, 10);

const bookingReviews = all
  .filter((review) => review.source === "booking" && review.rating >= 8 && review.text.trim().length > 30)
  .slice(0, 10);

const copy = {
  pl: {
    title: "To mówią",
    accent: "nasi goście",
    lead: "Nie kupujemy opinii i nie prosimy o nie przy wymeldowaniu. Te pochodzą z publicznych profili Google i Booking.com — także te mniej wygodne.",
    totalLabel: "opinii w Google i Booking.com",
    verified: "Profile publiczne, opinie weryfikowalne",
    googleRow: "Google",
    bookingRow: "Booking.com",
    profile: "Zobacz profil",
    pause: "Pauza",
    play: "Wznów",
    readMore: "Czytaj więcej",
    readLess: "Zwiń",
    footNote: "Każdą opinię można sprawdzić w profilu, z którego pochodzi.",
    cta: "Sprawdź dostępność",
  },
  en: {
    title: "What our",
    accent: "guests say",
    lead: "We do not buy reviews and we never ask for them at check-out. These come from public Google and Booking.com profiles — including the less comfortable ones.",
    totalLabel: "reviews on Google and Booking.com",
    verified: "Public profiles, verifiable reviews",
    googleRow: "Google",
    bookingRow: "Booking.com",
    profile: "View profile",
    pause: "Pause",
    play: "Resume",
    readMore: "Read more",
    readLess: "Show less",
    footNote: "Every review can be checked in the profile it came from.",
    cta: "Check availability",
  },
  de: {
    title: "Das sagen",
    accent: "unsere Gäste",
    lead: "Wir kaufen keine Bewertungen und fragen beim Check-out nie danach. Diese stammen aus öffentlichen Google- und Booking.com-Profilen — auch die unbequemen.",
    totalLabel: "Bewertungen auf Google und Booking.com",
    verified: "Öffentliche Profile, überprüfbare Bewertungen",
    googleRow: "Google",
    bookingRow: "Booking.com",
    profile: "Profil ansehen",
    pause: "Pause",
    play: "Weiter",
    readMore: "Weiterlesen",
    readLess: "Zuklappen",
    footNote: "Jede Bewertung lässt sich im jeweiligen Profil prüfen.",
    cta: "Verfügbarkeit prüfen",
  },
}[locale];

const fmtScore = (score: number) => score.toString().replace(".", ",");
const platform = (source: "google" | "booking") => aggregateRatings.find((rating) => rating.source === source);
const google = platform("google");
const booking = platform("booking");
---

<section class="revs" id="opinie" aria-labelledby="revs-title">
  <div class="container">
    <header class="revs__head">
      <div class="revs__intro" data-reveal>
        <span class="eyebrow">{tr.reviews.eyebrow}</span>
        <h2 class="revs__title" id="revs-title">
          {copy.title} <em>{copy.accent}</em>
        </h2>
        <p class="revs__lead">{copy.lead}</p>
      </div>

      <aside class="revs__summary" data-reveal style="--reveal-delay:90ms" aria-label={tr.reviews.eyebrow}>
        <p class="revs__summary-top">
          <strong class="revs__total">{total}</strong>
          <span>{copy.totalLabel}</span>
        </p>

        <ul class="revs__platforms" role="list">
          {aggregateRatings.map((rating) => (
            <li>
              <a
                class="revs__platform"
                href={rating.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${rating.label} — ${fmtScore(rating.score)}/${rating.scale} (${rating.count})`}
              >
                <ReviewLogo source={rating.source} />
                <span class="revs__score tnum">
                  {fmtScore(rating.score)}<em>/{rating.scale}</em>
                </span>
                <span class="revs__count">({rating.count})</span>
                <ReviewStars rating={rating.score} scale={rating.scale} size={12} />
              </a>
            </li>
          ))}
        </ul>

        <p class="revs__verified">
          <Icon name="check" size={14} />
          {copy.verified}
        </p>
      </aside>
    </header>

    <div class="revs__rows">
      <div class="revs__row">
        <div class="revs__row-head">
          <span class="revs__row-label">
            <ReviewLogo source="google" />
            <span>{copy.googleRow} · {google?.count}</span>
          </span>
          <div class="revs__row-actions">
            <button
              class="revs__pause"
              type="button"
              data-marquee-toggle
              data-pause={copy.pause}
              data-play={copy.play}
              aria-pressed="false"
            >
              {copy.pause}
            </button>
            <a class="revs__row-link" href={google?.url} target="_blank" rel="noopener noreferrer">
              {copy.profile}
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>

        <div class="revs__viewport" aria-label={`${copy.googleRow} — ${copy.totalLabel}`}>
          <div class="revs__track">
            <div class="revs__group">
              {googleReviews.map((review) => (
                <TestimonialCard review={review} moreLabel={copy.readMore} lessLabel={copy.readLess} />
              ))}
            </div>
            <div class="revs__group" aria-hidden="true" inert>
              {googleReviews.map((review) => (
                <TestimonialCard review={review} moreLabel={copy.readMore} lessLabel={copy.readLess} duplicate />
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="revs__row">
        <div class="revs__row-head">
          <span class="revs__row-label">
            <ReviewLogo source="booking" />
            <span>{copy.bookingRow} · {booking?.count}</span>
          </span>
          <div class="revs__row-actions">
            <button
              class="revs__pause"
              type="button"
              data-marquee-toggle
              data-pause={copy.pause}
              data-play={copy.play}
              aria-pressed="false"
            >
              {copy.pause}
            </button>
            <a class="revs__row-link" href={booking?.url} target="_blank" rel="noopener noreferrer">
              {copy.profile}
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>

        <div class="revs__viewport" aria-label={`${copy.bookingRow} — ${copy.totalLabel}`}>
          <div class="revs__track revs__track--reverse">
            <div class="revs__group">
              {bookingReviews.map((review) => (
                <TestimonialCard review={review} moreLabel={copy.readMore} lessLabel={copy.readLess} />
              ))}
            </div>
            <div class="revs__group" aria-hidden="true" inert>
              {bookingReviews.map((review) => (
                <TestimonialCard review={review} moreLabel={copy.readMore} lessLabel={copy.readLess} duplicate />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="revs__foot">
      <p class="revs__foot-note">{copy.footNote}</p>
      <div class="revs__actions">
        <a class="btn btn--primary" href={localeLink(locale, "/rezerwacja/")}>{copy.cta}</a>
      </div>
    </footer>
  </div>
</section>

<style>
  .revs {
    position: relative;
    padding-block: var(--section-y);
    background: var(--color-bg-muted);
    border-block: 1px solid var(--color-line);
    overflow: hidden;
  }

  .revs__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .revs__head {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-12);
    }
  }

  .revs__intro {
    max-width: 44rem;
  }

  .revs__title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: clamp(2.4rem, 5.2vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .revs__title em {
    font-style: italic;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.08em;
  }

  .revs__lead {
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* ------------------------------------------------------------- Resumen */

  .revs__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .revs__summary-top {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    max-width: none;
  }

  .revs__total {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4rem);
    line-height: 0.9;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .revs__summary-top span {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    line-height: 1.35;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .revs__platforms {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .revs__platform {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: var(--space-1) 0;
    color: inherit;
    transition: opacity var(--transition-base);
  }

  .revs__platform:hover {
    opacity: 0.7;
  }

  .revs__platform :global(.rlogo) {
    flex-shrink: 0;
  }

  .revs__score {
    margin-left: auto;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-text);
  }

  .revs__score em {
    font-style: normal;
    font-size: 0.6em;
    color: var(--color-text-subtle);
  }

  .revs__count {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .revs__verified {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: none;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    line-height: 1.4;
    color: var(--color-text-subtle);
  }

  .revs__verified :global(.icon) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------- Cintas */

  .revs__rows {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-10);
  }

  .revs__row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .revs__row-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .revs__row-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .revs__row-link,
  .revs__pause {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .revs__pause {
    color: var(--color-text-subtle);
  }

  .revs__pause:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .revs__row-link:hover {
    text-decoration: underline;
  }

  .revs__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }

  .revs__track {
    display: flex;
    width: max-content;
    animation: revs-scroll 86s linear infinite;
    will-change: transform;
  }

  .revs__track--reverse {
    animation-direction: reverse;
    animation-duration: 94s;
  }

  .revs__group {
    display: flex;
    gap: var(--space-4);
    padding-right: var(--space-4);
  }

  .revs__viewport:hover .revs__track,
  .revs__viewport:focus-within .revs__track,
  .revs__viewport.is-paused .revs__track {
    animation-play-state: paused;
  }

  @keyframes revs-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ---------------------------------------------------------------- Cierre */

  .revs__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .revs__foot-note {
    max-width: 46ch;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .revs__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  @media (max-width: 767px) {
    .revs__summary {
      padding: var(--space-5);
    }

    .revs__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .revs__track,
    .revs__track--reverse {
      animation-duration: 70s;
    }

    .revs__foot {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .revs__track,
    .revs__track--reverse {
      animation: none;
    }

    .revs__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .revs__group {
      scroll-snap-align: start;
    }

    .revs__group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-review-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const card = button.closest<HTMLElement>("[data-review-card]");
      if (!card) return;
      const open = card.classList.toggle("is-open");
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? (button.dataset.less ?? "Zwiń") : (button.dataset.more ?? "Czytaj więcej");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-marquee-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const row = button.closest(".revs__row");
      const viewport = row?.querySelector<HTMLElement>(".revs__viewport");
      if (!viewport) return;
      const paused = viewport.classList.toggle("is-paused");
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = paused ? (button.dataset.play ?? "Wznów") : (button.dataset.pause ?? "Pauza");
    });
  });
</script>

---
/**
 * Testimonials — prueba social con las opiniones en el idioma del visitante.
 *
 * Estructura: valoraciones por plataforma (RatingSummary) + carrusel navegable
 * por teclado, con puntos, flechas y swipe. Prioriza las opiniones escritas en
 * el idioma del mercado (ver reviewsForLocale).
 */
import { type Locale, getLocaleFromUrl, localeLink, t } from "~/lib/i18n";
import { reviewsForLocale } from "~/data/reviews";
import Icon from "~/components/ui/Icon.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import RatingSummary from "~/components/ui/RatingSummary.astro";

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);

const items = reviewsForLocale(locale).slice(0, limit);

/** Etiqueta del mes en el idioma de la página. */
const months: Record<Locale, string[]> = {
  pl: ["sty", "lut", "mar", "kwi", "maj", "cze", "lip", "sie", "wrz", "paź", "lis", "gru"],
  en: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
  de: ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"],
};

const fmtDate = (value: string) => {
  const [year, month] = value.split("-");
  const index = Number(month) - 1;
  return `${months[locale][index] ?? month} ${year}`;
};

const toTen = (rating: number, scale: number) => (rating / scale) * 10;
---

<section class="rev section" id="opinie">
  <div class="container">
    <SectionHeading eyebrow={tr.reviews.eyebrow} title={tr.home.reviewsTitle} lead={tr.home.reviewsLead} />

    <!-- Valoraciones por plataforma -->
    <div class="rev__summary" data-reveal>
      <RatingSummary size={22} />
    </div>

    <!-- Carrusel -->
    <div
      class="rev__carousel"
      data-carousel
      data-interval="7000"
      role="group"
      aria-roledescription="carousel"
      aria-label={tr.reviews.title}
      tabindex="0"
    >
      <div class="rev__viewport" data-carousel-viewport>
        {items.map((review, index) => (
          <article
            class="rev__slide"
            data-carousel-slide={index}
            aria-hidden={index === 0 ? "false" : "true"}
            aria-label={`${index + 1} / ${items.length}`}
          >
            <div class="rev__card">
              <Icon name="quote" fill size={26} class="rev__quote" />

              <p class="rev__text">{review.text}</p>

              <footer class="rev__footer">
                <div class="rev__author">
                  <span class="rev__avatar" aria-hidden="true">{review.author.slice(0, 1)}</span>
                  <span class="rev__author-text">
                    <strong>{review.author}</strong>
                    <span>
                      {review.country}
                      {review.stay ? ` · ${review.stay[locale]}` : ""}
                    </span>
                  </span>
                </div>

                <div class="rev__meta">
                  <span class:list={["rev__badge", `rev__badge--${review.source}`]}>
                    {review.source === "booking" ? tr.reviews.sourceBooking : tr.reviews.sourceGoogle}
                  </span>
                  <span class="rev__date">{fmtDate(review.date)}</span>
                  <span class="rev__score">
                    {toTen(review.rating, review.ratingScale).toFixed(1).replace(".", ",")}
                    <em>/10</em>
                  </span>
                </div>
              </footer>
            </div>
          </article>
        ))}
      </div>

      <div class="rev__controls">
        <button class="rev__nav" type="button" aria-label={tr.a11y.prevPhoto} data-carousel-prev>
          <Icon name="arrow-right" size={18} class="rev__nav-icon rev__nav-icon--prev" />
        </button>

        <div class="rev__dots" role="tablist" aria-label={tr.reviews.title}>
          {items.map((_, index) => (
            <button
              class="rev__dot"
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`${index + 1}`}
              data-carousel-dot={index}
            ></button>
          ))}
        </div>

        <button class="rev__nav" type="button" aria-label={tr.a11y.nextPhoto} data-carousel-next>
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>

    <div class="rev__cta" data-reveal>
      <a class="btn btn--outline" href={localeLink(locale, "/opinie/")}>
        {tr.cta.seeAllReviews}
      </a>
    </div>
  </div>
</section>

<style>
  .rev {
    background: var(--color-bg);
  }

  /* ------------------------------------------------------------- Resumen */

  .rev__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-6) var(--space-10);
    padding: var(--space-6) var(--space-8);
    margin-bottom: var(--space-10);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
  }

  .rev__overall {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .rev__overall-score {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .rev__overall-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .rev__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-brass);
  }

  /* Estrella apagada = gris de línea. Con trazo dorado parecía activa. */
  .rev__stars :global(.is-off) {
    color: var(--color-line-strong);
  }

  .rev__stars :global(svg) {
    fill: currentColor;
    stroke: none;
  }

  .rev__overall-label {
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rev__sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .rev__source {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0 var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .rev__source:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .rev__source-name {
    grid-column: 1;
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text);
  }

  .rev__source-score {
    grid-column: 2;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .rev__source-score em {
    font-style: normal;
    font-size: 0.6em;
    color: var(--color-text-subtle);
  }

  .rev__source-count {
    grid-column: 1 / -1;
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  .rev__source :global(.icon) {
    display: none;
  }

  /* ------------------------------------------------------------ Carrusel */

  .rev__carousel {
    position: relative;
  }

  .rev__viewport {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    gap: var(--space-4);
  }

  .rev__viewport::-webkit-scrollbar {
    display: none;
  }

  .rev__slide {
    scroll-snap-align: center;
  }

  .rev__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    height: 100%;
    min-height: 17rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
  }

  .rev__quote {
    color: var(--color-accent-soft);
    opacity: 0.6;
  }

  .rev__text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .rev__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .rev__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rev__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-faded);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .rev__author-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .rev__author-text strong {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .rev__author-text span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .rev__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rev__badge {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .rev__badge--booking {
    background: #e8f0fa;
    color: #1b4f8f;
  }

  .rev__date {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .rev__score {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .rev__score em {
    font-style: normal;
    font-size: 0.62em;
    color: var(--color-text-subtle);
  }

  /* ------------------------------------------------------------ Controles */

  .rev__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .rev__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-full);
    transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }

  .rev__nav:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .rev__nav-icon--prev {
    transform: rotate(180deg);
  }

  .rev__dots {
    display: flex;
    gap: var(--space-2);
  }

  .rev__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-line-strong);
    transition: background-color var(--transition-base), width var(--transition-base);
  }

  .rev__dot[aria-selected="true"] {
    width: 1.5rem;
    background: var(--color-accent);
  }

  .rev__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const viewport = root.querySelector<HTMLElement>("[data-carousel-viewport]");
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!viewport || slides.length === 0) return;

    let index = 0;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let timer: number | undefined;

    const goTo = (target: number) => {
      index = (target + slides.length) % slides.length;
      const slide = slides[index];
      if (!slide) return;
      viewport.scrollTo({
        left: slide.offsetLeft - viewport.offsetLeft,
        behavior: reduced.matches ? "auto" : "smooth",
      });
      dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === index ? "true" : "false"));
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduced.matches || slides.length < 2) return;
      const interval = Number(root.dataset.interval ?? 7000);
      timer = window.setInterval(() => goTo(index + 1), interval);
    };

    // Sincroniza el índice cuando el usuario arrastra con el dedo
    let scrollTimer: number | undefined;
    viewport.addEventListener(
      "scroll",
      () => {
        if (scrollTimer !== undefined) window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const closest = slides.reduce(
            (best, slide, i) => {
              const distance = Math.abs(slide.offsetLeft - viewport.offsetLeft - viewport.scrollLeft);
              return distance < best.distance ? { i, distance } : best;
            },
            { i: index, distance: Number.POSITIVE_INFINITY },
          );
          index = closest.i;
          dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === index ? "true" : "false"));
        }, 120);
      },
      { passive: true },
    );

    prev?.addEventListener("click", () => {
      goTo(index - 1);
      if (timer !== undefined) start();
    });

    next?.addEventListener("click", () => {
      goTo(index + 1);
      if (timer !== undefined) start();
    });

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        if (timer !== undefined) start();
      }),
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(index - 1);
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  });
</script>

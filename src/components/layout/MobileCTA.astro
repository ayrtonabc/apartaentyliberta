---
/**
 * MobileCTA — barra de acción fija en móvil.
 *
 * El objetivo comercial de esta barra es que la reserva esté siempre a un
 * toque de distancia. Jerarquía: reservar (primario) → llamar → escribir.
 */
import { type Locale, getLocaleFromUrl, localeLink, t } from "~/lib/i18n";
import { site } from "~/data/site";

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);
---

<div class="mcta" role="region" aria-label={tr.cta.checkAvailability}>
  <a class="mcta__main" href={localeLink(locale, "/rezerwacja/")}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2"></rect>
      <path d="M16 2v4M8 2v4M3 10h18"></path>
    </svg>
    <span>{tr.cta.checkAvailability}</span>
  </a>

  <a class="mcta__icon" href={`tel:${site.phone.tel}`} aria-label={`${tr.cta.call} ${site.phone.display}`}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </a>

  <a class="mcta__icon" href={`mailto:${site.email}`} aria-label={tr.cta.email}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>
</div>

<style>
  .mcta {
    position: fixed;
    left: var(--space-3);
    right: var(--space-3);
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-lg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
  }

  .mcta__main {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.85rem var(--space-4);
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    border-radius: var(--radius-full);
    font-family: var(--font-grotesk);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    box-shadow: var(--shadow-glow);
  }

  .mcta__main:active {
    background: var(--color-accent-hover);
  }

  .mcta__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.85rem;
    height: 2.85rem;
    flex-shrink: 0;
    color: var(--color-text);
    background: var(--color-bg-muted);
    border-radius: var(--radius-full);
    transition: background-color var(--transition-base);
  }

  .mcta__icon .icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .mcta__icon:active {
    background: var(--color-accent-faded);
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .mcta {
      display: none;
    }
  }
</style>

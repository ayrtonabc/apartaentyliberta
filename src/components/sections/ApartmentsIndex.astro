---
/**
 * ApartmentsIndex — listado completo de apartamentos con tabla comparativa.
 * Compartido por /apartamenty/, /en/apartments/ y /de/ferienwohnungen/.
 */
import { type Locale, localeLink, t } from "~/lib/i18n";
import { apartments } from "~/data/apartments";
import { formatPLN } from "~/lib/format";

import ApartmentCard from "~/components/content/ApartmentCard.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import FacilitiesGrid from "~/components/sections/FacilitiesGrid.astro";
import Icon from "~/components/ui/Icon.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import SmartImage from "~/components/ui/SmartImage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const intro: Record<Locale, { eyebrow: string; title: string; lead: string; note: string }> = {
  pl: {
    eyebrow: "Liberta I–IV",
    title: "Cztery apartamenty, jeden standard",
    lead: "Wszystkie apartamenty mają identyczny metraż i wyposażenie. Różni je tylko widok z tarasu — dlatego nie pobieramy dopłaty za „lepszy” apartament.",
    note: "Każdy apartament: 80 m², 3 sypialnie, prywatna balia góralska, zadaszony taras z grillem i miejsce parkingowe.",
  },
  en: {
    eyebrow: "Liberta I–IV",
    title: "Four apartments, one standard",
    lead: "Every apartment has the same floor area and equipment. Only the view from the terrace differs — which is why we never charge extra for a “better” apartment.",
    note: "Each apartment: 80 m², 3 bedrooms, a private wood-fired hot tub, a covered terrace with a BBQ and a parking space.",
  },
  de: {
    eyebrow: "Liberta I–IV",
    title: "Vier Ferienwohnungen, ein Standard",
    lead: "Alle Ferienwohnungen haben die gleiche Fläche und Ausstattung. Unterschiedlich ist nur der Blick von der Terrasse — deshalb berechnen wir nie einen Aufpreis für die „bessere“ Wohnung.",
    note: "Jede Wohnung: 80 m², 3 Schlafzimmer, privater Holz-Hot-Tub, überdachte Terrasse mit Grill und ein Parkplatz.",
  },
};

/**
 * La comparativa se divide en dos bloques, porque son dos preguntas distintas:
 *   - "different": lo único que cambia entre apartamentos (el precio y la vista).
 *     Es la información por la que el huésped viene a esta tabla.
 *   - "shared": el estándar idéntico en los cuatro. Se afirma una vez, no cuatro.
 * Repetir "80 m²" en cuatro columnas no ayuda a decidir a nadie.
 */
const different = [
  {
    key: "view",
    label: "",
    value: (index: number) => data.views[index] ?? "",
  },
  {
    key: "price",
    label: `${tr.pricing.lowSeason} (${tr.apartment.from})`,
    value: (index: number) => formatPLN(apartments[index].pricing.lowSeasonPLN),
    emphasis: true,
  },
];

const shared = [
  { label: tr.apartment.size, value: `${apartments[0].specs.sizeM2} m²` },
  { label: tr.apartment.sleeps, value: `${apartments[0].specs.sleeps} + ${apartments[0].specs.extraSleeps}` },
  { label: tr.apartment.bedrooms, value: `${apartments[0].specs.bedrooms}` },
  { label: tr.apartment.bathrooms, value: `${apartments[0].specs.bathrooms}` },
  { label: tr.apartment.distanceToLake, value: `${apartments[0].specs.distanceToLakeM} m` },
  { label: tr.amenityLabelHotTub, value: "✓" },
  { label: tr.amenityLabelTerrace, value: "✓" },
  { label: tr.trust.climatized, value: "✓" },
  { label: tr.amenityLabelParking, value: "✓" },
];

const data = {
  pl: {
    compareTitle: "Co je różni, a co łączy",
    compareLead:
      "Standard i metraż są identyczne w każdym apartamencie. Wybór sprowadza się do widoku z tarasu — dlatego nie pobieramy dopłaty za „lepszy” apartament.",
    viewTitle: "Widok z tarasu",
    sharedTitle: "Identyczne w każdym apartamencie",
    views: ["Jezioro i pomosty", "Plaża i pomost", "Zachód słońca", "Plaża i balia"],
  },
  en: {
    compareTitle: "What differs, what is shared",
    compareLead:
      "The standard and the floor area are identical in every apartment. The choice comes down to the view from the terrace — which is why we never charge extra for a “better” apartment.",
    viewTitle: "View from the terrace",
    sharedTitle: "Identical in every apartment",
    views: ["Lake and piers", "Beach and pier", "Sunset", "Beach and hot tub"],
  },
  de: {
    compareTitle: "Was unterscheidet, was verbindet",
    compareLead:
      "Standard und Fläche sind in allen Wohnungen gleich. Die Wahl reduziert sich auf den Blick von der Terrasse — deshalb berechnen wir nie einen Aufpreis für die „bessere“ Wohnung.",
    viewTitle: "Blick von der Terrasse",
    sharedTitle: "In jeder Wohnung identisch",
    views: ["See und Stege", "Strand und Steg", "Sonnenuntergang", "Strand und Hot Tub"],
  },
}[locale];

const header = intro[locale];
---

<!-- ================================================================ CABECERA -->
<section class="apt-head">
  <div class="container">
    <div class="apt-head__grid split split--text-heavy">
      <div data-reveal>
        <span class="eyebrow">{header.eyebrow}</span>
        <h1 class="apt-head__title">{header.title}</h1>
        <p class="lead">{header.lead}</p>
        <p class="apt-head__note">
          <Icon name="info" size={16} />
          {header.note}
        </p>
        <div class="btn-group">
          <a class="btn btn--primary" href={localeLink(locale, "/rezerwacja/")}>
            {tr.cta.checkAvailability}
          </a>
          <a class="btn btn--outline" href={localeLink(locale, "/cennik/")}>
            {tr.pricing.title}
          </a>
        </div>
      </div>

      <figure class="apt-head__figure" data-reveal style="--reveal-delay:120ms">
        <SmartImage
          src="/assets/apartments/liberta-ii/exterior-dzien.jpg"
          alt={
            locale === "pl"
              ? "Kompleks Apartamentów Liberta nad Jeziorem Szeląg"
              : locale === "de"
                ? "Die Anlage Apartamenty Liberta am Szeląg-See"
                : "The Apartamenty Liberta complex on Lake Szeląg"
          }
          sizes="(min-width: 1024px) 40vw, 100vw"
          priority
        />
      </figure>
    </div>
  </div>
</section>

<!-- ============================================================ APARTAMENTOS -->
<section class="section section--tight">
  <div class="container">
    <div class="apt-list">
      {apartments.map((apartment, index) => (
        <ApartmentCard apartment={apartment} layout="horizontal" index={index} locale={locale} />
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ INSTALACIONES -->
<!--
  Va entre el listado y la comparativa a propósito: primero se ve qué es cada
  apartamento, y justo antes de compararlos se explica lo que comparten, que es
  lo que de verdad diferencia la estancia.
-->
<FacilitiesGrid locale={locale} />

<!-- ============================================================= COMPARATIVA -->
<section class="section section--bg">
  <div class="container">
    <SectionHeading eyebrow={header.eyebrow} title={data.compareTitle} lead={data.compareLead} />

    <div class="cmp" data-reveal>
      <table class="cmp__table">
        <caption class="sr-only">{data.compareTitle}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{tr.apartment.apartmentAria}</span></th>
            {apartments.map((apartment) => (
              <th scope="col">
                <a href={localeLink(locale, `/apartamenty/${apartment.slugs[locale]}/`)}>
                  <span class="cmp__num">{apartment.number}</span>
                  <span class="cmp__name">
                    {locale === "pl" ? "Apartament" : locale === "de" ? "Ferienwohnung" : "Apartment"} {apartment.number}
                  </span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {different.map((row) => (
            <tr>
              <th scope="row">{row.label || data.viewTitle}</th>
              {apartments.map((_, index) => (
                <td class:list={[row.emphasis && "is-emphasis"]}>{row.value(index)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Lo que NO cambia: se afirma una vez en lugar de repetirlo en 4 columnas -->
    <div class="shared" data-reveal>
      <h3 class="shared__title">{data.sharedTitle}</h3>
      <ul class="shared__list" role="list">
        {shared.map((item) => (
          <li>
            <Icon name="check" size={15} />
            <span class="shared__label">{item.label}</span>
            <span class="shared__value">{item.value}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="cmp__hint">
      <Icon name="info" size={15} />
      {tr.home.pricingIncludesNote}
    </p>
  </div>
</section>

<CtaBand title={tr.home.ctaBandTitle} text={tr.home.ctaBandText} note={tr.home.ctaBandNote} />

<style>
  .apt-head {
    padding-top: calc(var(--header-height) + var(--space-10));
    padding-bottom: var(--space-12);
    background: var(--color-bg);
  }

  @media (min-width: 1024px) {
    .apt-head {
      padding-top: calc(var(--header-height-lg) + var(--space-12));
    }
  }

  .apt-head__title {
    margin-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-5xl);
  }

  .apt-head__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--color-accent-faded);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: 60ch;
  }

  .apt-head__note :global(.icon) {
    color: var(--color-accent);
    margin-top: 0.15em;
    flex-shrink: 0;
  }

  .apt-head__figure {
    overflow: hidden;
    border-radius: var(--radius-xl);
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 1024px) {
    .apt-head__figure {
      aspect-ratio: 3 / 4;
    }
  }

  /* Listado */

  .apt-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* Comparativa */

  .cmp {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
  }

  .cmp__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 42rem;
    font-variant-numeric: tabular-nums;
  }

  .cmp__table th,
  .cmp__table td {
    padding: var(--space-4) var(--space-5);
    text-align: center;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .cmp__table thead th {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    border-bottom: none;
    padding-block: var(--space-5);
  }

  .cmp__table thead a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: inherit;
  }

  .cmp__table thead a:hover .cmp__name {
    color: var(--color-accent-soft);
  }

  .cmp__num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .cmp__name {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--on-dark-text-muted);
    transition: color var(--transition-base);
  }

  .cmp__table tbody th {
    text-align: left;
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .cmp__table tbody tr:hover {
    background: var(--color-accent-faded);
  }

  .cmp__table tbody tr:last-child th,
  .cmp__table tbody tr:last-child td {
    border-bottom: none;
  }

  .cmp__hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: none;
  }

  .cmp__hint :global(.icon) {
    color: var(--color-accent);
  }

  .cmp__table tbody td.is-emphasis {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* ------------------------------------------------- Lo que no cambia */

  .shared {
    margin-top: var(--space-8);
    padding: var(--space-7);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
  }

  .shared__title {
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .shared__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3) var(--space-8);
  }

  @media (min-width: 640px) {
    .shared__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .shared__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .shared__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .shared__list :global(.icon) {
    color: var(--color-accent);
    flex-shrink: 0;
    align-self: center;
  }

  .shared__label {
    flex: 1;
    color: var(--color-text-muted);
  }

  .shared__value {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>

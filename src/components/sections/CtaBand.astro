---
/**
 * CtaBand — banda de cierre con llamada a la acción.
 * Bloque de conversión: fecha, teléfono y formulario a un clic.
 */
import { type Locale, getLocaleFromUrl, localeLink, t } from "~/lib/i18n";
import { site } from "~/data/site";
import SmartImage from "~/components/ui/SmartImage.astro";

interface Props {
  title: string;
  text: string;
  note?: string;
  image?: string;
}

const {
  title,
  text,
  note,
  image = "/assets/apartments/liberta-iv/exterior-noc.jpg",
} = Astro.props;

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);
---

<section class="cta-band">
  <div class="cta-band__media" aria-hidden="true">
    <SmartImage src={image} alt="" sizes="100vw" noPlaceholder />
  </div>
  <div class="cta-band__scrim" aria-hidden="true"></div>

  <div class="container cta-band__inner">
    <div class="cta-band__text" data-reveal>
      <span class="eyebrow eyebrow--inverse">{tr.cta.bookNow}</span>
      <h2 class="cta-band__title">{title}</h2>
      <p class="cta-band__lead">{text}</p>
      {note && <p class="cta-band__note">{note}</p>}
    </div>

    <div class="cta-band__actions" data-reveal style="--reveal-delay:100ms">
      <a class="btn btn--primary btn--xl" href={localeLink(locale, "/rezerwacja/")}>
        {tr.cta.checkAvailability}
      </a>
      <a class="btn btn--invert btn--xl" href={`tel:${site.phone.tel}`}>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {site.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    padding-block: clamp(3.5rem, 8vw, 7rem);
    isolation: isolate;
  }

  .cta-band__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .cta-band__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .cta-band__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(105deg, rgba(6, 14, 11, 0.94) 0%, rgba(6, 14, 11, 0.78) 48%, rgba(6, 14, 11, 0.42) 100%);
  }

  .cta-band__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .cta-band__inner {
      grid-template-columns: 1.35fr auto;
      gap: var(--space-16);
    }
  }

  .cta-band__title {
    margin-top: var(--space-4);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-inverse);
    max-width: 22ch;
  }

  .cta-band__lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--on-dark-text);
    max-width: 52ch;
  }

  .cta-band__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--on-dark-text-muted);
    max-width: 52ch;
  }

  .cta-band__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .cta-band__actions {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .cta-band__actions {
      flex-direction: column;
      min-width: 17rem;
    }
  }
</style>

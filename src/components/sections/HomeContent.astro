---
/**
 * HomeContent — cuerpo completo de la portada, parametrizado por idioma.
 *
 * Se usa desde /, /en/ y /de/ pasando la ruta canónica. Así una sola fuente
 * mantiene las tres versiones idénticas en estructura y contenido traducido,
 * en lugar de tres copias divergentes.
 */
import {
  type Locale,
  localeLink,
  t,
  localeMeta,
} from "~/lib/i18n";
import { site } from "~/data/site";
import { apartments } from "~/data/apartments";
import { formatPLN } from "~/lib/format";

import Hero from "~/components/sections/Hero.astro";
import TrustStrip from "~/components/sections/TrustStrip.astro";
import AttractionCardHome from "~/components/content/AttractionCardHome.astro";
import { attractions } from "~/data/attractions";
import AmenitiesShowcase from "~/components/sections/AmenitiesShowcase.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import Testimonials from "~/components/content/Testimonials.astro";
import FaqSection from "~/components/content/FaqSection.astro";
import MapEmbed from "~/components/content/MapEmbed.astro";
import Icon from "~/components/ui/Icon.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import SmartImage from "~/components/ui/SmartImage.astro";
import PhotoGallery from "~/components/ui/PhotoGallery.astro";
import ApartmentCard from "~/components/content/ApartmentCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const lowestPrice = Math.min(...apartments.map((a) => a.pricing.lowSeasonPLN));
const highestPrice = Math.max(...apartments.map((a) => a.pricing.highSeasonPLN));

/**
 * Fotos del mosaico del complejo, tomadas de public/assets/facilities.
 *
 * Antes eran fotos de apartamentos concretos. Se cambiaron por las de
 * instalaciones porque esta sección habla del COMPLEJO ("idéntico standard,
 * lo único que cambia es la vista"), no de una unidad concreta.
 *
 * Solo la primera lleva `span: "big"`: es la foto destacada y ocupa 2×2. Las
 * demás son celdas iguales, colocadas por posición desde el CSS de PhotoGallery.
 * Se probó a dar huecos altos a las fotos verticales y anchos a las apaisadas
 * para recortar menos, pero el resultado era irregular y las verticales en celda
 * baja se veían como tiras. Todas las celdas comparten proporción (1,40) y el
 * conjunto se lee regular. Las proporciones de los archivos están en
 * scripts/ratio-facilities.mjs.
 */
const facilities = "/assets/facilities";

const complexPhotos = [
  /*
   * LAS 15 FOTOS DEL MOSAICO, EN EL ORDEN DE LA RETÍCULA.
   *
   * El ORDEN MANDA: PhotoGallery le asigna a cada hueco un grid-area por POSICIÓN,
   * así que mover una foto de sitio cambia su tamaño. Las posiciones 2, 3 y 6 son
   * los huecos verticales; la 4, la 8 y la 13 son las bandas apaisadas.
   *
   * Ese reparto NO es estético: depende de la proporción de cada archivo, medida en
   * scripts/ratio-facilities.mjs. Las tres verticales del set (0,75) van a los
   * huecos de 0,65; en una celda base (1,33) perderían la mitad de la imagen por
   * los lados. Las apaisadas van a las bandas de 2,72.
   *
   * Y la composición tampoco se eligió a ojo: se buscó con
   * scripts/solve-mosaic.mjs, que prueba por backtracking qué combinaciones de
   * piezas (big 6x2, tall 3x2, wide 6x1, base 3x1) caben en una retícula de 12x6
   * sin dejar huecos. Con 14 fotos ninguna combinación con tres verticales se puede
   * colocar; con 15 sí, y esa es la que está.
   *
   * Los cuatro intentos anteriores, hechos a ojo, dejaron huecos. El mapa de
   * ocupación se comprueba con scripts/verify-mosaic-grid.mjs.
   */
  // 1. big 6x2
  {
    src: `${facilities}/apartament-z-zewnatrz.webp`,
    full: "/assets/responsive/assets/facilities/apartament-z-zewnatrz-1100.webp",
    alt:
      locale === "pl"
        ? "Kompleks Apartamentów Liberta z zewnątrz, oświetlone tarasy wieczorem"
        : locale === "de"
          ? "Die Anlage Apartamenty Liberta von außen, beleuchtete Terrassen am Abend"
          : "The Apartamenty Liberta complex from outside, terraces lit in the evening",
  },
  // 2. tall 3x2 - vertical 0,75
  {
    src: `${facilities}/sauna.webp`,
    full: "/assets/responsive/assets/facilities/sauna-1086.webp",
    alt:
      locale === "pl"
        ? "Sauna w formie beczki z widokiem na jezioro"
        : locale === "de"
          ? "Fasssauna mit Blick auf den See"
          : "Barrel sauna with a view of the lake",
  },
  // 3. tall 3x2 - vertical 0,75
  {
    src: `${facilities}/kuchnia.webp`,
    full: "/assets/responsive/assets/facilities/kuchnia-1086.webp",
    alt:
      locale === "pl"
        ? "Kuchnia z wyspą, drewnianym blatem i stołem"
        : locale === "de"
          ? "Küche mit Kochinsel, Holzplatte und Tisch"
          : "Kitchen with an island, wooden worktop and table",
  },
  // 4. wide 6x1 - la más apaisada (1,80)
  {
    src: `${facilities}/lake.webp`,
    full: "/assets/responsive/assets/facilities/lake-1400.webp",
    alt:
      locale === "pl"
        ? "Paddleboardy na Jeziorze Szeląg Wielki o zachodzie słońca"
        : locale === "de"
          ? "Stand-Up-Paddler auf dem Szeląg-See bei Sonnenuntergang"
          : "Paddleboarders on Lake Szeląg Wielki at sunset",
  },
  // 5. base 3x1
  {
    src: `${facilities}/salon-z-kominkiem.webp`,
    full: "/assets/responsive/assets/facilities/salon-z-kominkiem-1100.webp",
    alt:
      locale === "pl"
        ? "Salon z kominkiem na drewno i kanapą"
        : locale === "de"
          ? "Wohnzimmer mit Holzofen und Sofa"
          : "Living room with a wood-burning fireplace and sofa",
  },
  // 6. tall 3x2 - vertical 0,75
  {
    src: `${facilities}/play.webp`,
    full: "/assets/responsive/assets/facilities/play-1400.webp",
    alt:
      locale === "pl"
        ? "Siatkówka plażowa na piasku o zachodzie słońca"
        : locale === "de"
          ? "Beachvolleyball im Sand bei Sonnenuntergang"
          : "Beach volleyball on the sand at sunset",
  },
  // 7. base 3x1
  {
    src: `${facilities}/balia.webp`,
    full: "/assets/responsive/assets/facilities/balia-1080.webp",
    alt:
      locale === "pl"
        ? "Balia góralska z hydromasażem o zachodzie słońca"
        : locale === "de"
          ? "Holz-Hot-Tub mit Hydromassage bei Sonnenuntergang"
          : "Wooden hot tub with hydromassage at sunset",
  },
  // 8. wide 6x1
  {
    src: `${facilities}/miejsce-na-ognisko.webp`,
    full: "/assets/responsive/assets/facilities/miejsce-na-ognisko-1100.webp",
    alt:
      locale === "pl"
        ? "Zadaszony taras z meblami i widokiem na jezioro"
        : locale === "de"
          ? "Überdachte Terrasse mit Möbeln und Seeblick"
          : "Covered terrace with furniture and a lake view",
  },
  // 9. base 3x1
  {
    src: `${facilities}/lazienka.webp`,
    full: "/assets/responsive/assets/facilities/lazienka-1100.webp",
    alt:
      locale === "pl"
        ? "Łazienka z prysznicem walk-in i podwieszanym sedesem"
        : locale === "de"
          ? "Badezimmer mit Walk-in-Dusche und wandhängendem WC"
          : "Bathroom with a walk-in shower and a wall-hung toilet",
  },
  // 10. base 3x1
  {
    src: `${facilities}/sypialnia.webp`,
    full: "/assets/responsive/assets/facilities/sypialnia-1086.webp",
    alt:
      locale === "pl"
        ? "Sypialnia z łóżkiem małżeńskim i drewnianym sufitem"
        : locale === "de"
          ? "Schlafzimmer mit Doppelbett und Holzdecke"
          : "Bedroom with a double bed and wooden ceiling",
  },
  // 11. base 3x1
  {
    src: `${facilities}/jadalnia.webp`,
    full: "/assets/responsive/assets/facilities/jadalnia-1100.webp",
    alt:
      locale === "pl"
        ? "Jadalnia otwarta na salon, z dużym stołem"
        : locale === "de"
          ? "Essbereich, offen zum Wohnzimmer, mit großem Tisch"
          : "Dining area open to the living room, with a large table",
  },
  // 12. base 3x1
  {
    src: `${facilities}/plac-zabaw.webp`,
    full: "/assets/responsive/assets/facilities/plac-zabaw-1080.webp",
    alt:
      locale === "pl"
        ? "Drewniany plac zabaw na trawie przy jeziorze"
        : locale === "de"
          ? "Holzspielplatz auf der Wiese am See"
          : "Wooden playground on the grass by the lake",
  },
  // 13. base 3x1
  {
    src: `${facilities}/taras.webp`,
    full: "/assets/responsive/assets/facilities/taras-1100.webp",
    alt:
      locale === "pl"
        ? "Ognisko nad brzegiem jeziora o zachodzie słońca"
        : locale === "de"
          ? "Feuerstelle am Seeufer bei Sonnenuntergang"
          : "Fire pit on the lake shore at sunset",
  },
  // 14. base 3x1
  {
    src: `${facilities}/sypialnia-dwuosobowa.webp`,
    full: "/assets/responsive/assets/facilities/sypialnia-dwuosobowa-1100.webp",
    alt:
      locale === "pl"
        ? "Druga sypialnia z dwoma osobnymi łóżkami"
        : locale === "de"
          ? "Zweites Schlafzimmer mit zwei Einzelbetten"
          : "Second bedroom with two single beds",
  },
  // 15. base 3x1
  /*
   * EL PLANO AÉREO NO VA EN EL MOSAICO.
   *
   * El propietario pidió quitar esta imagen del grid visual porque ya aparece
   * como foto principal de la sección "Sobre nosotros" justo encima, y repetir
   * el mismo plano técnico en la galería de decoración del complejo ensucia el
   * mosaico. Pero sigue siendo una foto útil para un huésped curioso, así que
   * se mantiene en el lightbox: al abrir cualquier foto y navegar con las
   * flechas, el plano aparece como una más del recorrido.
   *
   * Se implementa como `hiddenFromGrid` en <PhotoGallery>: la foto existe en
   * el array, pero el componente no la pinta en el mosaico, solo inyecta un
   * botón "fantasma" para que el lightbox y las flechas la alcancen.
   */
];

/**
 * Fotos que SÍ se ven en el mosaico (visiblePhotos) + las que solo viven en el
 * lightbox (`hiddenFromGrid`). Aquí ya se devuelve el array completo de fotos
 * con el plano incluido, y se le pasa al componente la lista de las que debe
 * ocultar del grid.
 */
const complexPhotosWithPlan = [
  ...complexPhotos,
  {
    src: `${facilities}/plan-osrodka.webp`,
    full: "/assets/responsive/assets/facilities/plan-osrodka-1400.webp",
    alt:
      locale === "pl"
        ? "Plan kompleksu z lotu ptaka z oznaczonymi strefami"
        : locale === "de"
          ? "Lageplan der Anlage aus der Luft mit markierten Bereichen"
          : "Aerial site plan of the complex with marked areas",
  },
];

const planSrc = `${facilities}/plan-osrodka.webp`;

/*
 * FOTOS QUE NO VAN EN EL MOSAICO, SOLO EN EL LIGHTBOX.
 *
 * El cliente pidió que el grid de la galería no muestre las tres últimas
 * fotos del set (plac-zabaw, taras, sypialnia-dwuosobowa). Las fotos
 * merecen estar (son del complejo, no sobran), pero al final del mosaico
 * alargaban la rejilla una fila más sin aportar jerarquía: la fila 6 ya
 * cerraba visualmente con la 11-15.
 *
 * Mantenerlas dentro del array con el flag `hiddenFromGrid` hace que
 * sigan siendo accesibles: al abrir cualquier foto del grid y navegar
 * con flechas, aparecen en el recorrido del lightbox (el contador
 * refleja el total real, p.ej. "5 / 17"). Si el cliente decide después
 * mostrarlas, basta con quitar el src de esta lista.
 */
/*
 * FOTOS QUE NO VAN EN EL MOSAICO, SOLO EN EL LIGHTBOX.
 *
 * El cliente pidió que SOLO las 6 primeras fotos del set sean visibles
 * en el grid de la home. El resto (más el plano aéreo, que ya estaba
 * oculto) viven en el array pero no se renderizan en el mosaico: el
 * usuario las descubre al abrir cualquier foto y navegar con flechas.
 *
 * Las 6 que SÍ se ven son:
 *   1. apartament-z-zewnatrz    (la destacada, big 6×2)
 *   2. sauna                     (vertical, base)
 *   3. kuchnia                   (vertical, base)
 *   4. lake                      (wide 6×1)
 *   5. salon-z-kominkiem         (wide 6×1)
 *   6. play                      (vertical, wide)
 *
 * Total ocultas = 8 (5 nuevas + 3 anteriores) + 1 plano = 9 inaccesibles
 * desde el grid; el lightbox sigue contando las 14 + plano = 15 reales.
 *
 * Mantenerlas dentro del array con el flag `hiddenFromGrid` hace que
 * sigan siendo accesibles: al abrir cualquier foto del grid y navegar
 * con flechas, aparecen en el recorrido del lightbox (el contador
 * refleja el total real, p.ej. "5 / 15"). Si el cliente decide después
 * mostrarlas, basta con quitar el src de esta lista.
 */
const hiddenInGrid = [
  `${facilities}/balia.webp`,
  `${facilities}/miejsce-na-ognisko.webp`,
  `${facilities}/lazienka.webp`,
  `${facilities}/sypialnia.webp`,
  `${facilities}/jadalnia.webp`,
  `${facilities}/plac-zabaw.webp`,
  `${facilities}/taras.webp`,
  `${facilities}/sypialnia-dwuosobowa.webp`,
];

const distances = [
  { icon: "waves" as const, label: tr.home.locationDistanceLake, value: tr.home.locationDistanceLakeValue },
  { icon: "utensils" as const, label: tr.home.locationDistanceShop, value: tr.home.locationDistanceShopValue },
  { icon: "pin" as const, label: tr.home.locationDistanceOlsztyn, value: tr.home.locationDistanceOlsztynValue },
  { icon: "pin" as const, label: tr.home.locationDistanceOstroda, value: tr.home.locationDistanceOstrodaValue },
  { icon: "plane" as const, label: tr.home.locationDistanceAirport, value: tr.home.locationDistanceAirportValue },
  { icon: "car" as const, label: tr.home.locationDistanceGdansk, value: tr.home.locationDistanceGdanskValue },
];

const includes = [
  tr.home.pricingInclude1,
  tr.home.pricingInclude2,
  tr.home.pricingInclude3,
  tr.home.pricingInclude4,
];

const aboutTitle =
  locale === "pl"
    ? "Domki letniskowe na Mazurach — i coś znacznie więcej"
    : locale === "de"
      ? "Ferienhäuser in Masuren — und noch viel mehr"
      : "Holiday homes in Masuria — and a great deal more";
---

<Hero />

<TrustStrip />

<!-- ===================================================== SOBRE NOSOTROS -->
<section class="about section">
  <div class="container">
    <div class="about__stack">
      <div class="about__col" data-reveal>
        <span class="eyebrow">{tr.home.aboutEyebrow}</span>
        <h2 class="about__title">{aboutTitle}</h2>

        <div class="prose">
          <p>{tr.home.aboutLead}</p>
          <p>{tr.home.aboutLeadMore}</p>
        </div>

        <div class="btn-group">
          <a class="btn btn--outline" href={localeLink(locale, "/lokalizacja/")}>
            {tr.home.locationMore}
          </a>
          <a class="btn btn--ghost btn--link" href={localeLink(locale, "/atrakcje/")}>
            {tr.home.experiencesAll}
          </a>
        </div>
      </div>

      <figure class="about__figure" data-reveal>
        <SmartImage
          src="/assets/facilities/plan-osrodka.webp"
          alt={
            locale === "pl"
              ? "Zdjęcie lotnicze kompleksu z zaznaczonymi punktami: apartamenty, rekreacja, plaża, marina, bar i slip"
              : locale === "de"
                ? "Luftaufnahme der Anlage mit markierten Punkten: Ferienwohnungen, Freizeit, Strand, Marina, Bar und Slipanlage"
                : "Aerial view of the complex with marked points: apartments, recreation, beach, marina, bar and slipway"
          }
          sizes="(min-width: 1024px) 34vw, 100vw"
        />
      </figure>
    </div>
  </div>
</section>

<!-- ================================================== LOS APARTAMENTOS -->
<section class="section section--bg" id="apartamenty">
  <div class="container">
    <div class="section-head-split">
      <div class="section-head-split__text" data-reveal>
        <span class="eyebrow">Liberta I–IV</span>
        <h2>{tr.home.apartmentsTitle}</h2>
        <p class="lead">{tr.home.apartmentsLead}</p>
      </div>
      <a class="btn btn--outline" href={localeLink(locale, "/apartamenty/")} data-reveal>
        {tr.cta.seeAllApartments}
      </a>
    </div>

    <div class="apt-grid">
      {apartments.map((apartment, index) => (
        <ApartmentCard apartment={apartment} layout="vertical" index={index} />
      ))}
    </div>

    <!-- Mosaico del complejo, con galería -->
    <div class="complex">
      <div class="complex__gallery">
        <PhotoGallery
          photos={complexPhotosWithPlan}
          hiddenFromGrid={[planSrc, ...hiddenInGrid]}
          label={
            locale === "pl"
              ? "Galeria zdjęć kompleksu"
              : locale === "de"
                ? "Fotogalerie der Anlage"
                : "Photo gallery of the complex"
          }
          closeLabel={locale === "pl" ? "Zamknij" : locale === "de" ? "Schließen" : "Close"}
          prevLabel={locale === "pl" ? "Poprzednie zdjęcie" : locale === "de" ? "Vorheriges Bild" : "Previous photo"}
          nextLabel={locale === "pl" ? "Następne zdjęcie" : locale === "de" ? "Nächstes Bild" : "Next photo"}
          counterLabel="x"
        />
      </div>

      <div class="complex__aside" data-reveal>
        <h3 class="complex__aside-title">{tr.apartment.compareTitle}</h3>
        <p class="complex__aside-text">{tr.apartment.compareLead}</p>
        <a class="btn btn--primary" href={localeLink(locale, "/apartamenty/")}>
          {tr.cta.compare}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================= POR QUÉ LIBERTA -->
<section class="reasons section">
  <div class="container">
    <SectionHeading eyebrow={tr.home.whyEyebrow} title={tr.home.whyTitle} lead={tr.home.whyLead} />

    <ol class="reasons__list" role="list">
      {[1, 2, 3, 4].map((n) => (
        <li class="reasons__item" data-reveal style={`--reveal-delay:${(n - 1) * 60}ms`}>
          <span class="reasons__num">{String(n).padStart(2, "0")}</span>
          <div>
            <h3 class="reasons__name">
              {n === 1 && tr.home.reason1Title}
              {n === 2 && tr.home.reason2Title}
              {n === 3 && tr.home.reason3Title}
              {n === 4 && tr.home.reason4Title}
            </h3>
            <p class="reasons__text">
              {n === 1 && tr.home.reason1Text}
              {n === 2 && tr.home.reason2Text}
              {n === 3 && tr.home.reason3Text}
              {n === 4 && tr.home.reason4Text}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- =========================================================== EQUIPAMIENTO -->
<AmenitiesShowcase />

<!-- ============================================================ EXPERIENCIAS -->
<section class="section">
  <div class="container">
    <SectionHeading
      eyebrow={tr.home.experiencesEyebrow}
      title={tr.home.experiencesTitle}
      lead={tr.home.experiencesLead}
    />

    <!--
      Mismas filas alternadas que en /atrakcje/, con los seis primeros sitios.
      Antes era una rejilla de tarjetas con icono; ahora que hay foto propia de
      cada sitio, el icono sobra y la tarjeta pequeña se queda corta.

      EN LA HOME SE USA UNA VARIANTE DISTINTA, NO AttractionRow.

      /atrakcje/ muestra filas alternadas (imagen a un lado, texto al otro)
      porque ahí la foto grande ayuda a vender el sitio. En la portada, en
      cambio, queremos una rejilla 3×2 más densa y "preview": las seis
      atracciones entran en una sola pantalla sinスクロール largo, y la foto
      aparece al hover para no robar protagonismo al bloque "O nas" que está
      justo encima con su imagen grande. El componente AttractionCardHome es
      una pieza específica para este uso, no una variante de AttractionRow.
    -->
    <div class="ahgrid">
      {attractions
        .filter((a) => a.image)
        .slice(0, 6)
        .map((attraction) => (
          <AttractionCardHome
            image={attraction.image}
            alt={attraction.imageAlt?.[locale] ?? attraction.name[locale]}
            eyebrow={
              attraction.distanceKm === undefined
                ? undefined
                : attraction.distanceKm < 1
                  ? `${Math.round(attraction.distanceKm * 1000)} m`
                  : `${attraction.distanceKm} km`
            }
            title={attraction.name[locale]}
            text={attraction.description[locale]}
          />
        ))}
    </div>

    <div class="text-center u-mt-12">
      <a class="btn btn--outline btn--lg" href={localeLink(locale, "/atrakcje/")}>
        {tr.home.experiencesAll}
      </a>
    </div>
  </div>
</section>

<!-- ============================================================= UBICACIÓN -->
<section class="section section--bg">
  <div class="container">
    <div class="loc__grid split split--reversed">
      <div class="loc__text" data-reveal>
        <span class="eyebrow">{tr.home.locationEyebrow}</span>
        <h2 class="loc__title">{tr.home.locationTitle}</h2>
        <p class="lead">{tr.home.locationLead}</p>

        <ul class="loc__distances" role="list">
          {distances.map((item) => (
            <li>
              <span class="loc__distance-icon"><Icon name={item.icon} size={18} /></span>
              <span class="loc__distance-label">{item.label}</span>
              <span class="loc__distance-value">{item.value}</span>
            </li>
          ))}
        </ul>

        <div class="loc__contact">
          <p class="loc__contact-line">
            <Icon name="pin" size={16} />
            <span>{site.address.full}</span>
          </p>
          <p class="loc__contact-line">
            <Icon name="info" size={16} />
            <span>{tr.home.locationGps}: {site.geo.latDMS}, {site.geo.lngDMS}</span>
          </p>
        </div>

        <a class="btn btn--primary" href={localeLink(locale, "/lokalizacja/")}>
          {tr.home.locationDirections}
        </a>
      </div>

      <figure class="loc__map" data-reveal style="--reveal-delay:120ms">
        <MapEmbed zoom={13} />
      </figure>
    </div>
  </div>
</section>

<!-- ================================================================ PRECIOS -->
<section class="section" id="cennik">
  <div class="container">
    <SectionHeading
      eyebrow={tr.home.pricingEyebrow}
      title={tr.home.pricingTitle}
      lead={tr.home.pricingLead}
    />

    <div class="price-preview">
      <div class="price-preview__cards" data-reveal>
        <article class="price-preview__card">
          <span class="price-preview__season">{tr.home.pricingSeasonLow}</span>
          <span class="price-preview__amount">
            {formatPLN(lowestPrice)}
            <em>{tr.home.pricingPerNight}</em>
          </span>
          <span class="price-preview__note">{tr.home.pricingSeasonLowMonths}</span>
        </article>

        <article class="price-preview__card price-preview__card--accent">

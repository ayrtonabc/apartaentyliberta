---
/**
 * HomeContent — cuerpo completo de la portada, parametrizado por idioma.
 *
 * Se usa desde /, /en/ y /de/ pasando la ruta canónica. Así una sola fuente
 * mantiene las tres versiones idénticas en estructura y contenido traducido,
 * en lugar de tres copias divergentes.
 */
import {
  type Locale,
  localeLink,
  t,
  localeMeta,
} from "~/lib/i18n";
import { site } from "~/data/site";
import { apartments } from "~/data/apartments";

import Hero from "~/components/sections/Hero.astro";
import TrustStrip from "~/components/sections/TrustStrip.astro";
import AttractionCardHome from "~/components/content/AttractionCardHome.astro";
import { attractions } from "~/data/attractions";
import AmenitiesShowcase from "~/components/sections/AmenitiesShowcase.astro";
import WellnessSection from "~/components/sections/WellnessSection.astro";
import WelcomeSection from "~/components/sections/WelcomeSection.astro";
import PricingShowcase from "~/components/sections/PricingShowcase.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import Testimonials from "~/components/content/Testimonials.astro";
import VideoWallSection from "~/components/sections/VideoWallSection.astro";
import FaqSection from "~/components/content/FaqSection.astro";
import MapEmbed from "~/components/content/MapEmbed.astro";
import Icon from "~/components/ui/Icon.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import SmartImage from "~/components/ui/SmartImage.astro";
import ApartmentCard from "~/components/content/ApartmentCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const distances = [
  { icon: "waves" as const, label: tr.home.locationDistanceLake, value: tr.home.locationDistanceLakeValue },
  { icon: "utensils" as const, label: tr.home.locationDistanceShop, value: tr.home.locationDistanceShopValue },
  { icon: "pin" as const, label: tr.home.locationDistanceOlsztyn, value: tr.home.locationDistanceOlsztynValue },
  { icon: "pin" as const, label: tr.home.locationDistanceOstroda, value: tr.home.locationDistanceOstrodaValue },
  { icon: "plane" as const, label: tr.home.locationDistanceAirport, value: tr.home.locationDistanceAirportValue },
  { icon: "car" as const, label: tr.home.locationDistanceGdansk, value: tr.home.locationDistanceGdanskValue },
];

const aboutTitle =
  locale === "pl"
    ? "Domki letniskowe na Mazurach — i coś znacznie więcej"
    : locale === "de"
      ? "Ferienhäuser in Masuren — und noch viel mehr"
      : "Holiday homes in Masuria — and a great deal more";
---

<Hero />

<TrustStrip />

<!-- ===================================================== SOBRE NOSOTROS -->
<section class="about section">
  <div class="container">
    <div class="about__stack">
      <div class="about__col" data-reveal>
        <span class="eyebrow">{tr.home.aboutEyebrow}</span>
        <h2 class="about__title">{aboutTitle}</h2>

        <div class="prose">
          <p>{tr.home.aboutLead}</p>
          <p>{tr.home.aboutLeadMore}</p>
        </div>

        <div class="btn-group">
          <a class="btn btn--outline" href={localeLink(locale, "/lokalizacja/")}>
            {tr.home.locationMore}
          </a>
          <a class="btn btn--ghost btn--link" href={localeLink(locale, "/atrakcje/")}>
            {tr.home.experiencesAll}
          </a>
        </div>
      </div>

      <figure class="about__figure" data-reveal>
        <SmartImage
          src="/assets/facilities/plan-osrodka.webp"
          alt={
            locale === "pl"
              ? "Zdjęcie lotnicze kompleksu z zaznaczonymi punktami: apartamenty, rekreacja, plaża, marina, bar i slip"
              : locale === "de"
                ? "Luftaufnahme der Anlage mit markierten Punkten: Ferienwohnungen, Freizeit, Strand, Marina, Bar und Slipanlage"
                : "Aerial view of the complex with marked points: apartments, recreation, beach, marina, bar and slipway"
          }
          sizes="(min-width: 1024px) 34vw, 100vw"
        />
      </figure>
    </div>
  </div>
</section>

<!-- ================================================== LOS APARTAMENTOS -->
<section class="section section--bg" id="apartamenty">
  <div class="container">
    <div class="section-head-split">
      <div class="section-head-split__text" data-reveal>
        <span class="eyebrow">Liberta I–IV</span>
        <h2>{tr.home.apartmentsTitle}</h2>
        <p class="lead">{tr.home.apartmentsLead}</p>
      </div>
      <a class="btn btn--outline" href={localeLink(locale, "/apartamenty/")} data-reveal>
        {tr.cta.seeAllApartments}
      </a>
    </div>

    <div class="apt-grid">
      {apartments.map((apartment, index) => (
        <ApartmentCard apartment={apartment} layout="vertical" index={index} />
      ))}
    </div>

  </div>
</section>

<!-- ========================================================= BIENVENIDA -->
<WelcomeSection />

<!-- ======================================================= POR QUÉ LIBERTA -->
<section class="reasons section">
  <div class="container">
    <SectionHeading eyebrow={tr.home.whyEyebrow} title={tr.home.whyTitle} lead={tr.home.whyLead} />

    <ol class="reasons__list" role="list">
      {[1, 2, 3, 4].map((n) => (
        <li class="reasons__item" data-reveal style={`--reveal-delay:${(n - 1) * 60}ms`}>
          <span class="reasons__num">{String(n).padStart(2, "0")}</span>
          <div>
            <h3 class="reasons__name">
              {n === 1 && tr.home.reason1Title}
              {n === 2 && tr.home.reason2Title}
              {n === 3 && tr.home.reason3Title}
              {n === 4 && tr.home.reason4Title}
            </h3>
            <p class="reasons__text">
              {n === 1 && tr.home.reason1Text}
              {n === 2 && tr.home.reason2Text}
              {n === 3 && tr.home.reason3Text}
              {n === 4 && tr.home.reason4Text}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- =========================================================== EQUIPAMIENTO -->
<AmenitiesShowcase />

<!-- ================================================================ WELLNESS -->
<WellnessSection />

<!-- ============================================================ EXPERIENCIAS -->
<section class="section">
  <div class="container">
    <SectionHeading
      eyebrow={tr.home.experiencesEyebrow}
      title={tr.home.experiencesTitle}
      lead={tr.home.experiencesLead}
    />

    <!--
      Mismas filas alternadas que en /atrakcje/, con los seis primeros sitios.
      Antes era una rejilla de tarjetas con icono; ahora que hay foto propia de
      cada sitio, el icono sobra y la tarjeta pequeña se queda corta.

      EN LA HOME SE USA UNA VARIANTE DISTINTA, NO AttractionRow.

      /atrakcje/ muestra filas alternadas (imagen a un lado, texto al otro)
      porque ahí la foto grande ayuda a vender el sitio. En la portada, en
      cambio, queremos una rejilla 3×2 más densa y "preview": las seis
      atracciones entran en una sola pantalla sinスクロール largo, y la foto
      aparece al hover para no robar protagonismo al bloque "O nas" que está
      justo encima con su imagen grande. El componente AttractionCardHome es
      una pieza específica para este uso, no una variante de AttractionRow.
    -->
    <div class="ahgrid">
      {attractions
        .filter((a) => a.image)
        .slice(0, 6)
        .map((attraction) => (
          <AttractionCardHome
            image={attraction.image}
            alt={attraction.imageAlt?.[locale] ?? attraction.name[locale]}
            eyebrow={
              attraction.distanceKm === undefined
                ? undefined
                : attraction.distanceKm < 1
                  ? `${Math.round(attraction.distanceKm * 1000)} m`
                  : `${attraction.distanceKm} km`
            }
            title={attraction.name[locale]}
            text={attraction.description[locale]}
          />
        ))}
    </div>

    <div class="text-center u-mt-12">
      <a class="btn btn--outline btn--lg" href={localeLink(locale, "/atrakcje/")}>
        {tr.home.experiencesAll}
      </a>
    </div>
  </div>
</section>

<!-- ============================================================= UBICACIÓN -->
<section class="section section--bg">
  <div class="container">
    <div class="loc__grid split split--reversed">
      <div class="loc__text" data-reveal>
        <span class="eyebrow">{tr.home.locationEyebrow}</span>
        <h2 class="loc__title">{tr.home.locationTitle}</h2>
        <p class="lead">{tr.home.locationLead}</p>

        <ul class="loc__distances" role="list">
          {distances.map((item) => (
            <li>
              <span class="loc__distance-icon"><Icon name={item.icon} size={18} /></span>
              <span class="loc__distance-label">{item.label}</span>
              <span class="loc__distance-value">{item.value}</span>
            </li>
          ))}
        </ul>

        <div class="loc__contact">
          <p class="loc__contact-line">
            <Icon name="pin" size={16} />
            <span>{site.address.full}</span>
          </p>
          <p class="loc__contact-line">
            <Icon name="info" size={16} />
            <span>{tr.home.locationGps}: {site.geo.latDMS}, {site.geo.lngDMS}</span>
          </p>
        </div>

        <a class="btn btn--primary" href={localeLink(locale, "/lokalizacja/")}>
          {tr.home.locationDirections}
        </a>
      </div>

      <figure class="loc__map" data-reveal style="--reveal-delay:120ms">
        <MapEmbed zoom={13} />
      </figure>
    </div>
  </div>
</section>

<!-- ================================================================ PRECIOS -->
<PricingShowcase locale={locale} />

<!-- ================================================================= OPINIONES -->
<Testimonials limit={6} />

<!-- ============================================================ NAGRANO U NAS -->
<VideoWallSection />

<!-- ======================================================================= FAQ -->
<FaqSection limit={6} showFooterLink />

<!-- ================================================================== CONTACTO -->
<!-- ================================================================== CONTACTO -->
<!--
  Un único cierre de conversión.
  Antes había una sección de contacto con titular y CTA seguida de una banda CTA
  con el MISMO titular y los MISMOS botones, pegadas una detrás de otra. Aquí se
  queda solo la banda (más contundente); el bloque de canales (teléfono, email,
  dirección) y los dos botones finales también se eliminaron porque ya estaban
  dentro de la propia banda o se repiten en el pie de página. Pegar CtaBand al
  footer sin un bloque intermedio era justo lo que pasaba antes de este cambio
  y era lo que el cliente señaló.
-->
<CtaBand title={tr.home.ctaBandTitle} text={tr.home.ctaBandText} note={tr.home.ctaBandNote} />

<style>
  /*
   * REJILLA 3×2 DE EXPERIENCIAS (SOLO EN LA HOME).
   *
   *   móvil   (< 640 px)  →  1 columna × 6 filas
   *   tablet  (>= 640)    →  2 columnas × 3 filas
   *   desktop (>= 1024)   →  3 columnas × 2 filas
   *
   * El `min-height` mínimo evita que una card con poco texto se vea más baja
   * que las demás y rompa la rejilla. La altura real la dicta el contenido,
   * pero el mínimo la iguala al estado de hover (foto + veil) que es el más
   * exigente, así que la rejilla nunca "salta" al pasar el cursor de una
   * card a otra.
   *
   * NO se reutiliza la rejilla de `/atrakcje/` (AttractionRow): la home
   * necesita preview densa, no filas alternadas con foto grande. Mezclar las
   * dos con clases condicionales o variantes terminó antes en CSS que rompía
   * al cambiar de breakpoint, por eso es un componente aparte.
   */
  .ahgrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .ahgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .ahgrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  /* --------------------------------------------------------- Sobre nosotros */

  /*
   * TÍTULO "O nas" — LEGIBLE DE UN VISTAZO, SIN SALTOS INNECESARIOS.
   *
   * El texto completo mide ~50 caracteres. Con `text-5xl` y `max-width:
   * 28rem` (~448 px) el navegador lo partía en 4–5 líneas: el guion largo
   * se quedaba huérfano en su propia línea y las palabras como
   * "letniskowe" o "znacznie" no cabían enteras. Demasiado denso y
   * fatigante de leer.
   *
   * Tres ajustes lo arreglan:
   *
   *   1. font-size: `text-3xl` en móvil, `text-4xl` en escritorio.
   *      Suficiente para tener jerarquía de titular sin ser un grito.
   *
   *   2. max-width: 38rem en escritorio. Algo más ancho que antes, lo
   *      justo para que la línea más larga lleve 8–10 palabras y se
   *      pueda leer de corrido sin saltar de renglón a cada tres
   *      palabras.
   *
   *   3. line-height generoso (1.35) y tracking ligero negativo. Las
   *      líneas no se pegan entre sí y el bloque respira.
   *
   * `text-wrap: balance` se mantiene pero solo donde aporta (escritorio).
   * En móvil se desactiva y se permite `hyphens: auto` para que palabras
   * largas se corten si hace falta, sin desbordes.
   */
  .about__title {
    margin-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-3xl);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    max-width: none;
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .about__title {
      font-size: var(--text-4xl);
      line-height: 1.3;
      max-width: 38rem;
      text-wrap: balance;
    }
  }

  @media (max-width: 1023px) {
    .about__title {
      hyphens: auto;
    }
  }






  /*
   * LA SECCIÓN ES DE DOS COLUMNAS A PARTIR DE ESCRITORIO.
   *
   *   izquierda  →  texto (eyebrow, h2, dos párrafos, botones)
   *   derecha    →  figura (plano aéreo)
   *
   * Reglas del grid:
   *   - La altura la define el texto (align-items: stretch por defecto en grid).
   *     El contenedor de la imagen mide EXACTAMENTE lo que mide el texto, así
   *     ambas columnas terminan alineadas arriba y abajo sin que la imagen
   *     "flote" más alta que el bloque de texto.
   *   - El plano es 1.50 (apaisado, casi 3:2). Si le fijamos aspect-ratio, se
   *     recorta; si dejamos que crezca con la altura del texto y mantenga su
   *     proporción natural, ocupa menos ancho del disponible en su columna
   *     pero NO pierde ni un píxel vertical. La decisión fue esa: que la
   *     imagen sea proporcional al texto en altura, no que ocupe todo el
   *     ancho. Los rótulos Marina y Slip de los extremos siguen viéndose.
   *
   * En móvil (< 900 px) se apila: texto arriba, plano debajo a ancho
   * completo. Sin truncamientos, sin scroll horizontal.
   */
  .about__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  @media (min-width: 900px) {
    .about__stack {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: stretch;
      gap: var(--space-10);
    }
  }

  @media (min-width: 1280px) {
    .about__stack {
      gap: var(--space-12);
    }
  }

  /*
   * Columna de texto: a la izquierda, alineada al inicio, sin truncar.
   * Antes iba centrada y con max-width fijo; en la rejilla de 2 columnas eso
   * centraba el texto dentro de su propia columna (raro). Ahora se alinea
   * al inicio para que el bloque se lea como un párrafo al lado de la imagen.
   *
   * `justify-content: center` centra verticalmente el bloque respecto a la
   * altura de la fila. La fila toma la altura del elemento más alto, y como
   * las dos columnas son del mismo alto, el texto queda ópticamente alineado
   * con la imagen sin forzar un centrado raro del texto en sí.
   */
  .about__col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: none;
    text-align: left;
  }

  /*
   * LA FIGURA AHORA ES UN RECUADRO LLENO DE IMAGEN, SIN BANDAS.
   *
   * Cambio de contain → cover a petición del cliente: la imagen debe
   * rellenar al completo el contenedor aunque se recorten los bordes
   * laterales (el plano es 1.50 y la columna es ~1.0, así que el recorte
   * es horizontal y fino). Las dos consecuencias que importan:
   *
   *   1. No debe verse NADA detrás de la imagen: el figure pierde el
   *      `background: color-bg-muted` que actuaba como marco cuando
   *      sobraba hueco. Ahora, si la imagen no cubre un píxel, queda
   *      transparente, no gris.
   *
   *   2. La imagen ya no se centra con flex: pasa a llenar el figure con
   *      `width: 100%; height: 100%`, igual que un background. Eso permite
   *      que `object-fit: cover` recorte los lados simétricamente desde
   *      el centro.
   *
   * El figure sigue con `border-radius` y `overflow: hidden`, así las
   * esquinas del recorte siguen siendo las del contenedor, no esquinas
   * cuadradas de la imagen.
   *
   * El recorte lateral puede afectar a rótulos como "Marina" y "Slip" en
   * los extremos del plano: es la decisión explícita del cliente. Si
   * después prefiere recuperarlos, basta con volver a `contain` aquí.
   */
  .about__figure {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    width: 100%;
    height: 100%;
  }

  /*
   * La imagen ocupa el 100 % del figure y recorta lo que sobre por el
   * lado más largo. `object-position: center` mantiene el centro del plano
   * (la zona con más información) en el centro del figure; los rótulos de
   * los extremos pueden quedar parcialmente fuera.
   *
   * `:global` porque la imagen llega envuelta por SmartImage (un <img>
   * con su propio scoped style) y el CSS scoped de este componente no la
   * alcanzaría por defecto.
   */
  .about__figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /*
   * NO hay `position: sticky` en la figura.
   *
   * Lo tenía cuando iba en una columna al lado de un texto largo: acompañaba al
   * lector mientras bajaba. Ahora ocupa el ancho completo debajo del texto, así
   * que no hay nada que acompañar y el sticky solo daría un salto al llegar al
   * final de la sección.
   */

  /* ------------------------------------------------------------ Apartamentos */

  .apt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .apt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .apt-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ------------------------------------------------------------ Mosaico complejo */

  /* ----------------------------------------------------------------- Razones */

  .reasons__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .reasons__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-12);
    }
  }

  .reasons__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .reasons__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-accent-soft);
    font-variant-numeric: tabular-nums;
  }

  .reasons__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .reasons__text {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 42ch;
  }

  /* -------------------------------------------------------------- Ubicación */

  .loc__title {
    margin-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-4xl);
  }

  .loc__distances {
    display: grid;
    gap: 0;
    margin-block: var(--space-7);
    border-top: 1px solid var(--color-line);
  }

  .loc__distances li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .loc__distance-icon {
    color: var(--color-accent);
    display: inline-flex;
  }

  .loc__distance-label {
    color: var(--color-text-muted);
  }

  .loc__distance-value {
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .loc__contact {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
  }

  .loc__contact-line {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: none;
  }

  .loc__contact-line :global(.icon) {
    color: var(--color-accent);
    margin-top: 0.2em;
  }

  .loc__map {
    overflow: hidden;
    border-radius: var(--radius-xl);
    min-height: 22rem;
    border: 1px solid var(--color-line);
    background: var(--color-bg-muted);
  }

  @media (min-width: 1024px) {
    .loc__map {
      min-height: 30rem;
      height: 100%;
    }
  }

</style>

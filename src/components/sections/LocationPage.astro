---
/**
 * LocationPage — ubicación y cómo llegar.
 * Compartido por /lokalizacja/, /en/location/ y /de/lage/.
 */
import { type Locale, localeLink, t } from "~/lib/i18n";
import { site } from "~/data/site";
import { formatCoordinates } from "~/lib/format";

import PageHero from "~/components/ui/PageHero.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import MapEmbed from "~/components/content/MapEmbed.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import Icon from "~/components/ui/Icon.astro";
import SmartImage from "~/components/ui/SmartImage.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const coords = formatCoordinates(site.geo.lat, site.geo.lng);

const ways = [
  { icon: "car" as const, title: tr.location.byCar, text: tr.location.byCarText },
  { icon: "plane" as const, title: tr.location.byPlane, text: tr.location.byPlaneText },
  { icon: "train" as const, title: tr.location.byTrain, text: tr.location.byTrainText },
];

const distances = [
  { label: tr.home.locationDistanceLake, value: tr.home.locationDistanceLakeValue },
  { label: tr.home.locationDistanceShop, value: tr.home.locationDistanceShopValue },
  { label: tr.home.locationDistanceOlsztyn, value: tr.home.locationDistanceOlsztynValue },
  { label: tr.home.locationDistanceOstroda, value: tr.home.locationDistanceOstrodaValue },
  { label: tr.home.locationDistanceAirport, value: tr.home.locationDistanceAirportValue },
  { label: tr.home.locationDistanceGdansk, value: tr.home.locationDistanceGdanskValue },
];

const nearby = [
  { name: locale === "pl" ? "Olsztyn" : locale === "de" ? "Olsztyn" : "Olsztyn", slug: "olsztyn" },
  { name: locale === "pl" ? "Ostróda" : "Ostróda", slug: "ostroda" },
  { name: locale === "pl" ? "Olsztynek" : "Olsztynek", slug: "olsztynek" },
  { name: locale === "pl" ? "Kątno" : "Kątno", slug: "katno" },
];
---

<PageHero
  eyebrow={tr.location.eyebrow}
  title={tr.location.title}
  lead={tr.location.lead}
  crumbs={[
    { name: tr.nav.home, href: localeLink(locale, "/") },
    { name: tr.nav.location },
  ]}
/>

<!-- ==================================================================== MAPA + DATOS -->
<section class="section">
  <div class="container">
    <div class="loc split split--reversed split--start">
      <div class="loc__info" data-reveal>
        <dl class="loc__facts">
          <div>
            <dt><Icon name="pin" size={16} /> {tr.home.locationAddress}</dt>
            <dd>
              {site.address.street}<br />
              {site.address.postalCode} {site.address.locality}<br />
              {site.address.region}, {tr.footer.country}
            </dd>
          </div>
          <div>
            <dt><Icon name="info" size={16} /> {tr.home.locationGps}</dt>
            <dd class="tnum">{coords.lat}<br />{coords.lng}</dd>
          </div>
        </dl>

        <h2 class="loc__subtitle">{tr.home.locationDistances}</h2>
        <ul class="loc__distances" role="list">
          {distances.map((item) => (
            <li>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </li>
          ))}
        </ul>

        <div class="btn-group">
          <a
            class="btn btn--primary"
            href={`https://www.google.com/maps/dir/?api=1&destination=${site.geo.lat},${site.geo.lng}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="external" size={16} />
            {locale === "pl" ? "Wyznacz trasę" : locale === "de" ? "Route planen" : "Get directions"}
          </a>
          <a class="btn btn--outline" href={`tel:${site.phone.tel}`}>
            {site.phone.display}
          </a>
        </div>
      </div>

      <figure class="loc__map" data-reveal style="--reveal-delay:120ms">
        <MapEmbed zoom={12} title={tr.location.title} />
      </figure>
    </div>
  </div>
</section>

<!-- ==================================================================== CÓMO LLEGAR -->
<section class="section section--bg">
  <div class="container">
    <SectionHeading
      eyebrow={tr.location.eyebrow}
      title={locale === "pl" ? "Trzy sposoby, żeby do nas dotrzeć" : locale === "de" ? "Drei Wege zu uns" : "Three ways to reach us"}
      lead={
        locale === "pl"
          ? "Stare Jabłonki leżą dokładnie w połowie drogi między Olsztynem a Ostródą, przy trasie nad jezioro Szeląg."
          : locale === "de"
            ? "Stare Jabłonki liegt genau auf halber Strecke zwischen Olsztyn und Ostróda, an der Straße zum Szeląg-See."
            : "Stare Jabłonki sits exactly halfway between Olsztyn and Ostróda, on the road to Lake Szeląg."
      }
    />

    <ul class="ways" role="list">
      {ways.map((way, index) => (
        <li data-reveal style={`--reveal-delay:${index * 70}ms`}>
          <span class="ways__icon"><Icon name={way.icon} size={22} /></span>
          <h3 class="ways__title">{way.title}</h3>
          <p class="ways__text">{way.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ==================================================================== ENTORNO -->
<section class="section">
  <div class="container">
    <div class="near split split--balanced split--start">
      <div data-reveal>
        <span class="eyebrow">{tr.location.attractionsNearby}</span>
        <h2 class="near__title">
          {locale === "pl" ? "Miasta i wsie w okolicy" : locale === "de" ? "Städte und Dörfer in der Nähe" : "Towns and villages nearby"}
        </h2>
        <p class="lead">
          {locale === "pl"
            ? "Każde z tych miejsc warto odwiedzić — od gotyckiego zamku w Olsztynie po pochylnie kanału w Ostródzie."
            : locale === "de"
              ? "Jeder dieser Orte lohnt einen Besuch — vom gotischen Schloss in Olsztyn bis zu den Schiefen Ebenen bei Ostróda."
              : "Each of these places is worth a visit — from the Gothic castle in Olsztyn to the canal's inclined planes at Ostróda."}
        </p>

        <ul class="near__list" role="list">
          {nearby.map((place) => (
            <li>
              <a href={localeLink(locale, `/okolica/${place.slug}/`)}>
                <span>{place.name}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <figure class="near__figure" data-reveal style="--reveal-delay:120ms">
        <SmartImage
          src="/assets/editorial/mapa-dojazdu.jpg"
          alt={
            locale === "pl"
              ? "Mapa dojazdu do Apartamentów Liberta na Mazurach"
              : locale === "de"
                ? "Anfahrtskarte zu Apartamenty Liberta in Masuren"
                : "Map showing how to reach Apartamenty Liberta in Masuria"
          }
          sizes="(min-width: 1024px) 45vw, 100vw"
        />
      </figure>
    </div>
  </div>
</section>

<CtaBand title={tr.home.ctaBandTitle} text={tr.home.ctaBandText} note={tr.home.ctaBandNote} image="/assets/editorial/mapa-dojazdu.jpg" />

<style>
  .loc__facts {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 560px) {
    .loc__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .loc__facts dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-2);
  }

  .loc__facts dt :global(.icon) {
    color: var(--color-accent);
  }

  .loc__facts dd {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .loc__subtitle {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }

  .loc__distances {
    display: grid;
    gap: 0;
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .loc__distances li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .loc__distances span {
    color: var(--color-text-muted);
  }

  .loc__distances strong {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .loc__map {
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-line);
    min-height: 24rem;
    background: var(--color-bg-muted);
  }

  @media (min-width: 1024px) {
    .loc__map {
      min-height: 32rem;
      height: 100%;
    }
  }

  /* Cómo llegar */
  .ways {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ways li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .ways__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-faded);
    color: var(--color-accent);
  }

  .ways__title {
    font-size: var(--text-xl);
  }

  .ways__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: none;
  }

  /* Entorno */
  .near__title {
    margin-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-4xl);
  }

  .near__list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-7);
  }

  .near__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .near__list a:hover {
    border-color: var(--color-accent);
    transform: translateX(3px);
  }

  .near__list :global(.icon) {
    color: var(--color-accent);
  }

  .near__figure {
    overflow: hidden;
    border-radius: var(--radius-xl);
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 1024px) {
    .near__figure {
      aspect-ratio: 3 / 4;
    }
  }
</style>

---
/**
 * PricingShowcase — cennik de la portada.
 *
 * Los cuatro apartamentos son idénticos: no tiene sentido repetir cuatro filas
 * con el mismo precio. Se muestra una sola ficha con capacidad, precio bajo y
 * alto, lo incluido, reserva y llamada. El diseño verde bosque y el teléfono
 * grande se mantienen.
 */
import { type Locale, localeLink, t } from "~/lib/i18n";
import { apartments } from "~/data/apartments";
import { site } from "~/data/site";
import { bookingUrl } from "~/data/booking";
import Icon from "~/components/ui/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const nf = (value: number) => String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, " ");

/** Los cuatro apartamentos comparten tarifa; se toma el mínimo/máximo real. */
const low = Math.min(...apartments.map((apartment) => apartment.pricing.lowSeasonPLN));
const high = Math.max(...apartments.map((apartment) => apartment.pricing.highSeasonPLN));

const copy = {
  pl: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Proste stawki za noc",
    lead: "Wszystkie apartamenty są takie same: 80 m², 6 + 2 osoby, prywatna balia i taras z widokiem na jezioro.",
    callLabel: "Wolisz zapytać?",
    callText: "Rezerwacje i pytania — zadzwoń, chętnie doradzimy.",
    callCta: "Zadzwoń teraz",
    all: "Wszystkie apartamenty",
    allName: "Liberta I–IV",
    capacity: "6 + 2 osoby",
    size: "80 m²",
    low: "Sezon niski",
    high: "Sezon wysoki",
    from: "od",
    perNight: "/ noc",
    includes: "W cenie",
    amenities: [
      "Prywatna balia góralska",
      "Taras z widokiem na jezioro",
      "WiFi i Netflix",
      "Parking przy apartamencie",
      "Klimatyzacja",
    ],
    booking: "Rezerwacja",
    bookingText: "Aktualne terminy i potwierdzenie w Booking.com.",
    cta: "Sprawdź terminy",
    call: "Zadzwoń",
    discount: "7+ nocy −5% · 13+ nocy −10%",
    note: "Dostawka w salonie dla 2 osób: 100 zł/noc. Sprzątanie końcowe i opłata klimatyczna — jednorazowo.",
    full: "Pełny cennik i usługi dodatkowe",
  },
  en: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Simple nightly rates",
    lead: "All apartments are the same: 80 m², 6 + 2 guests, a private hot tub and a terrace with lake views.",
    callLabel: "Prefer to ask?",
    callText: "Bookings and questions — call us, we are happy to help.",
    callCta: "Call now",
    all: "All apartments",
    allName: "Liberta I–IV",
    capacity: "6 + 2 guests",
    size: "80 m²",
    low: "Low season",
    high: "High season",
    from: "from",
    perNight: "/ night",
    includes: "Included",
    amenities: [
      "Private wood-fired hot tub",
      "Terrace with lake view",
      "WiFi and Netflix",
      "Parking at the apartment",
      "Air conditioning",
    ],
    booking: "Booking",
    bookingText: "Current dates and confirmation on Booking.com.",
    cta: "Check dates",
    call: "Call",
    discount: "7+ nights −5% · 13+ nights −10%",
    note: "Extra bed in the living room for 2: 100 PLN/night. Final cleaning and tourist tax — charged once.",
    full: "Full price list and extras",
  },
  de: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Einfache Nachtpreise",
    lead: "Alle Ferienwohnungen sind gleich: 80 m², 6 + 2 Gäste, privater Hot Tub und Terrasse mit Seeblick.",
    callLabel: "Lieber fragen?",
    callText: "Buchungen und Fragen — rufen Sie an, wir helfen gerne.",
    callCta: "Jetzt anrufen",
    all: "Alle Ferienwohnungen",
    allName: "Liberta I–IV",
    capacity: "6 + 2 Gäste",
    size: "80 m²",
    low: "Nebensaison",
    high: "Hochsaison",
    from: "ab",
    perNight: "/ Nacht",
    includes: "Inklusive",
    amenities: [
      "Privater Holz-Hot-Tub",
      "Terrasse mit Seeblick",
      "WiFi und Netflix",
      "Parkplatz an der Wohnung",
      "Klimaanlage",
    ],
    booking: "Buchung",
    bookingText: "Aktuelle Termine und Bestätigung auf Booking.com.",
    cta: "Termine prüfen",
    call: "Anrufen",
    discount: "7+ Nächte −5% · 13+ Nächte −10%",
    note: "Zustellbett im Wohnzimmer für 2: 100 PLN/Nacht. Endreinigung und Kurtaxe — einmalig.",
    full: "Vollständige Preisliste und Zusatzleistungen",
  },
}[locale];
---

<section class="pricing" id="cennik" aria-labelledby="pricing-title">
  <div class="container">
    <header class="pricing__head">
      <div class="pricing__intro" data-reveal>
        <span class="eyebrow eyebrow--inverse">{copy.eyebrow}</span>
        <h2 class="pricing__title" id="pricing-title">{copy.title}</h2>
        <p class="pricing__lead">{copy.lead}</p>
      </div>

      <aside class="pricing__call" data-reveal style="--reveal-delay:80ms">
        <span class="pricing__call-label">{copy.callLabel}</span>
        <a class="pricing__phone" href={`tel:${site.phone.tel}`}>
          {site.phone.display}
        </a>
        <p class="pricing__call-text">{copy.callText}</p>
        <a class="pricing__call-link" href={`tel:${site.phone.tel}`}>
          {copy.callCta}
          <Icon name="phone" size={15} />
        </a>
      </aside>
    </header>

    <div class="pricing__board" data-reveal>
      <div class="pricing__overview">
        <span class="pricing__overline">{copy.all}</span>
        <h3 class="pricing__name">{copy.allName}</h3>
        <p class="pricing__specs">
          <span><Icon name="users" size={15} /> {copy.capacity}</span>
          <span><Icon name="ruler" size={15} /> {copy.size}</span>
        </p>

        <div class="pricing__rates">
          <div>
            <span>{copy.low}</span>
            <strong>{copy.from} {nf(low)} zł <em>{copy.perNight}</em></strong>
          </div>
          <div class="pricing__rate--high">
            <span>{copy.high}</span>
            <strong>{nf(high)} zł <em>{copy.perNight}</em></strong>
          </div>
        </div>
      </div>

      <div class="pricing__amenities">
        <h3 class="pricing__block-title">{copy.includes}</h3>
        <ul role="list">
          {copy.amenities.map((amenity) => (
            <li>
              <Icon name="check" size={14} />
              {amenity}
            </li>
          ))}
        </ul>
      </div>

      <div class="pricing__booking">
        <h3 class="pricing__block-title">{copy.booking}</h3>
        <p>{copy.bookingText}</p>
        <div class="pricing__actions">
          <a class="btn btn--primary btn--full" href={bookingUrl(locale)} target="_blank" rel="noopener noreferrer">
            {copy.cta}
            <Icon name="arrow-right" size={15} />
          </a>
          <a class="pricing__call-action" href={`tel:${site.phone.tel}`}>
            <Icon name="phone" size={15} />
            {copy.call} · {site.phone.display}
          </a>
        </div>
      </div>
    </div>

    <div class="pricing__foot" data-reveal>
      <p class="pricing__discount">
        <Icon name="sparkles" size={15} />
        {copy.discount}
      </p>
      <p class="pricing__note">{copy.note}</p>
      <a class="pricing__full" href={localeLink(locale, "/cennik/")}>
        {copy.full}
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-y);
    background:
      radial-gradient(80% 70% at 90% 0%, rgba(176, 141, 74, 0.16), transparent 58%),
      var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .pricing__head {
    display: grid;
    gap: var(--space-8);
    align-items: end;
  }

  @media (min-width: 900px) {
    .pricing__head {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-12);
    }
  }

  .pricing__intro {
    max-width: 48rem;
  }

  .pricing__title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: clamp(1.9rem, 3.9vw, 3.2rem);
    line-height: 1.03;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  .pricing__lead {
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--on-dark-text-muted);
    text-wrap: pretty;
  }

  .pricing__call {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    color: var(--color-text);
  }

  .pricing__call-label {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pricing__phone {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.3vw, 2.85rem);
    font-weight: var(--weight-normal);
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .pricing__phone:hover {
    color: var(--color-accent);
  }

  .pricing__call-text {
    max-width: 30ch;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .pricing__call-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    margin-top: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pricing__call-link:hover {
    text-decoration: underline;
  }

  .pricing__board {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .pricing__board {
      grid-template-columns: 1.35fr 0.9fr 0.85fr;
    }
  }

  .pricing__overview,
  .pricing__amenities,
  .pricing__booking {
    padding: var(--space-6);
  }

  @media (min-width: 900px) {
    .pricing__overview,
    .pricing__amenities {
      border-right: 1px solid var(--color-line);
    }
  }

  .pricing__overline {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .pricing__name {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
    line-height: 1.15;
  }

  .pricing__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
    max-width: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pricing__specs span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .pricing__specs :global(.icon) {
    color: var(--color-accent);
  }

  .pricing__rates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .pricing__rates > div > span {
    display: block;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .pricing__rates strong {
    display: block;
    margin-top: 2px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    font-weight: var(--weight-normal);
    line-height: 1.15;
    color: var(--color-text);
  }

  .pricing__rates em {
    font-family: var(--font-grotesk);
    font-style: normal;
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .pricing__rate--high strong {
    color: var(--color-accent);
  }

  .pricing__block-title {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .pricing__amenities ul {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .pricing__amenities li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .pricing__amenities :global(.icon) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-accent);
  }

  .pricing__booking {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-accent-faded);
  }

  .pricing__booking p {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .pricing__actions {
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
  }

  .pricing__call-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pricing__call-action:hover {
    text-decoration: underline;
  }

  .pricing__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }

  .pricing__discount {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: none;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-light);
  }

  .pricing__note {
    flex: 1 1 26rem;
    max-width: 70ch;
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--on-dark-text-muted);
  }

  .pricing__full {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }

  .pricing__full:hover {
    color: var(--color-brass-light);
  }

  @media (max-width: 899px) {
    .pricing__overview,
    .pricing__amenities {
      border-bottom: 1px solid var(--color-line);
    }
  }

  @media (max-width: 479px) {
    .pricing__call,
    .pricing__overview,
    .pricing__amenities,
    .pricing__booking {
      padding: var(--space-4);
    }

    .pricing__phone {
      font-size: clamp(1.55rem, 7.4vw, 2rem);
    }

    .pricing__rates {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }

    .pricing__foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

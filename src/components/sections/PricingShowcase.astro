---
/**
 * PricingShowcase — tarifas de la portada, sin calculadora.
 *
 * El cliente pidió quitar el deslizador de noches y el total calculado: hacía
 * que la sección pareciera un presupuesto caro. Ahora se muestran cuatro
 * tarjetas claras, con la tarifa baja y alta por noche, y un único CTA a
 * Booking.com. Los precios salen de `apartments.ts`.
 */
import { type Locale, localeLink, t } from "~/lib/i18n";
import { apartments } from "~/data/apartments";
import { bookingUrl } from "~/data/booking";
import Icon from "~/components/ui/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const nf = (value: number) => String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, " ");

const copy = {
  pl: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Proste stawki za noc",
    lead: "Cena za cały apartament dla 6 osób — nie za osobę. Do 8 osób z dostawką w salonie; bez kalendarza, który podbija kwotę.",
    low: "Sezon niski",
    high: "Sezon wysoki",
    from: "od",
    perNight: "/ noc",
    cta: "Sprawdź terminy",
    full: "Pełny cennik i usługi dodatkowe",
    discount: "7+ nocy −5% · 13+ nocy −10%",
    note: "Cena obejmuje apartament dla 6 osób, WiFi, parking, balię i drewno. Dostawka w salonie dla 2 osób: 100 zł/noc. Sprzątanie końcowe i opłata klimatyczna są doliczane jednorazowo — potwierdzamy je przed rezerwacją.",
    people: "6 + 2 osoby",
    size: "80 m²",
    season: "Ceny za apartament",
  },
  en: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Simple nightly rates",
    lead: "The price is for the whole apartment for 6 guests — not per person. Up to 8 with an extra bed in the living room; no calendar inflating the total.",
    low: "Low season",
    high: "High season",
    from: "from",
    perNight: "/ night",
    cta: "Check dates",
    full: "Full price list and extras",
    discount: "7+ nights −5% · 13+ nights −10%",
    note: "The price covers the apartment for 6 guests, WiFi, parking, hot tub and firewood. Extra bed in the living room for 2: 100 PLN/night. Final cleaning and tourist tax are charged once — confirmed before booking.",
    people: "6 + 2 guests",
    size: "80 m²",
    season: "Price per apartment",
  },
  de: {
    eyebrow: tr.home.pricingEyebrow,
    title: "Einfache Nachtpreise",
    lead: "Der Preis gilt für die ganze Wohnung für 6 Gäste — nicht pro Person. Bis 8 mit Zustellbett im Wohnzimmer; kein Kalender, der die Summe aufbläht.",
    low: "Nebensaison",
    high: "Hochsaison",
    from: "ab",
    perNight: "/ Nacht",
    cta: "Termine prüfen",
    full: "Vollständige Preisliste und Zusatzleistungen",
    discount: "7+ Nächte −5% · 13+ Nächte −10%",
    note: "Der Preis umfasst die Wohnung für 6 Gäste, WiFi, Parkplatz, Hot Tub und Brennholz. Zustellbett im Wohnzimmer für 2: 100 PLN/Nacht. Endreinigung und Kurtaxe werden einmalig berechnet — vor der Buchung bestätigt.",
    people: "6 + 2 Gäste",
    size: "80 m²",
    season: "Preis pro Wohnung",
  },
}[locale];
---

<section class="pricing" id="cennik" aria-labelledby="pricing-title">
  <div class="container">
    <header class="pricing__head">
      <div class="pricing__intro" data-reveal>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2 class="pricing__title" id="pricing-title">{copy.title}</h2>
        <p class="pricing__lead">{copy.lead}</p>
      </div>

      <div class="pricing__seal" data-reveal style="--reveal-delay:80ms">
        <span class="pricing__seal-icon"><Icon name="shield" size={18} /></span>
        <span>
          <strong>{copy.season}</strong>
          <small>{copy.discount}</small>
        </span>
      </div>
    </header>

    <ul class="pricing__grid" role="list" data-reveal>
      {apartments.map((apartment, index) => (
        <li class="pricing__card">
          <div class="pricing__card-head">
            <span class="pricing__number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="pricing__name">{apartment.names[locale]}</h3>
              <p class="pricing__specs">
                <span><Icon name="users" size={14} /> {copy.people}</span>
                <span><Icon name="ruler" size={14} /> {copy.size}</span>
              </p>
            </div>
          </div>

          <div class="pricing__rates">
            <div class="pricing__rate">
              <span>{copy.low}</span>
              <strong>{copy.from} {nf(apartment.pricing.lowSeasonPLN)} zł <em>{copy.perNight}</em></strong>
            </div>
            <div class="pricing__rate pricing__rate--high">
              <span>{copy.high}</span>
              <strong>{nf(apartment.pricing.highSeasonPLN)} zł <em>{copy.perNight}</em></strong>
            </div>
          </div>

          <a
            class="pricing__cta"
            href={bookingUrl(locale)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.cta}
            <Icon name="arrow-right" size={14} />
          </a>
        </li>
      ))}
    </ul>

    <div class="pricing__foot" data-reveal>
      <p class="pricing__note">{copy.note}</p>
      <a class="btn btn--primary" href={bookingUrl(locale)} target="_blank" rel="noopener noreferrer">
        {tr.booking.bookingCta}
        <Icon name="arrow-right" size={15} />
      </a>
      <a class="pricing__full" href={localeLink(locale, "/cennik/")}>
        {copy.full}
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-y);
    background: var(--color-bg-muted);
    border-block: 1px solid var(--color-line);
  }

  .pricing__head {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .pricing__head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-10);
    }
  }

  .pricing__intro {
    max-width: 48rem;
  }

  .pricing__title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: clamp(1.9rem, 3.9vw, 3.25rem);
    line-height: 1.03;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .pricing__lead {
    max-width: 58ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .pricing__seal {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 26rem;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .pricing__seal-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    color: var(--color-accent);
    background: var(--color-accent-faded);
    border-radius: var(--radius-full);
  }

  .pricing__seal strong,
  .pricing__seal small {
    display: block;
  }

  .pricing__seal strong {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .pricing__seal small {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 640px) {
    .pricing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pricing__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .pricing__card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .pricing__card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .pricing__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    background: var(--color-accent-faded);
    border-radius: var(--radius-full);
  }

  .pricing__name {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .pricing__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    max-width: none;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .pricing__specs span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .pricing__specs :global(.icon) {
    color: var(--color-accent);
  }

  .pricing__rates {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 420px) {
    .pricing__rates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pricing__rate {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pricing__rate > span {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .pricing__rate strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-normal);
    line-height: 1.15;
    color: var(--color-text);
  }

  .pricing__rate em {
    font-family: var(--font-grotesk);
    font-style: normal;
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .pricing__rate--high strong {
    color: var(--color-accent);
  }

  .pricing__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
    min-height: 2.75rem;
    padding-block: var(--space-3);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    border-top: 1px solid var(--color-line);
  }

  .pricing__cta:hover {
    color: var(--color-accent-hover);
  }

  .pricing__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .pricing__note {
    flex: 1 1 22rem;
    max-width: 62ch;
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .pricing__full {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pricing__full:hover {
    text-decoration: underline;
  }

  @media (max-width: 639px) {
    .pricing__card {
      padding: var(--space-5);
    }

    .pricing__foot {
      align-items: stretch;
      flex-direction: column;
    }

    .pricing__foot .btn {
      width: 100%;
    }
  }
</style>

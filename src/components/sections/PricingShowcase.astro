    .pricing__amount {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-pricing]");

  if (root) {
    const low = Number(root.dataset.low ?? 700);
    const high = Number(root.dataset.high ?? 900);
    const noteLow = root.dataset.noteLow ?? "";
    const noteHigh = root.dataset.noteHigh ?? "";
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-season]"));
    const range = root.querySelector<HTMLInputElement>("[data-nights]");
    const priceEl = root.querySelector<HTMLElement>("[data-price]");
    const priceOutEl = root.querySelector<HTMLElement>("[data-price-out]");
    const seasonNoteEl = root.querySelector<HTMLElement>("[data-season-note]");
    const nightsOut = Array.from(root.querySelectorAll<HTMLElement>("[data-nights-out]"));
    const subtotalEl = root.querySelector<HTMLElement>("[data-subtotal]");
    const discountRow = root.querySelector<HTMLElement>("[data-discount-row]");
    const discountPctEl = root.querySelector<HTMLElement>("[data-discount-pct]");
    const discountEl = root.querySelector<HTMLElement>("[data-discount]");
    const totalEl = root.querySelector<HTMLElement>("[data-total]");

    const nf = (value: number) => String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
    const pln = (value: number) => `${nf(value)} zł`;

    let season: "low" | "high" = "low";
    let nights = Number(range?.value ?? 7);

    const render = () => {
      const price = season === "low" ? low : high;
      const subtotal = price * nights;
      const pct = nights >= 13 ? 0.1 : nights >= 7 ? 0.05 : 0;
      const discount = Math.round(subtotal * pct);
      const total = subtotal - discount;

      buttons.forEach((button) => {
        const active = button.dataset.season === season;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      if (priceEl) priceEl.textContent = nf(price);
      if (priceOutEl) priceOutEl.textContent = nf(price);
      if (seasonNoteEl) seasonNoteEl.textContent = season === "low" ? noteLow : noteHigh;
      nightsOut.forEach((el) => (el.textContent = String(nights)));
      if (subtotalEl) subtotalEl.textContent = pln(subtotal);
      if (discountRow) discountRow.hidden = pct === 0;
      if (discountPctEl) discountPctEl.textContent = `${Math.round(pct * 100)}%`;
      if (discountEl) discountEl.textContent = `-${pln(discount)}`;
      if (totalEl) totalEl.textContent = pln(total);
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        season = button.dataset.season === "high" ? "high" : "low";
        render();
      });
    });

    range?.addEventListener("input", () => {
      nights = Number(range.value);
      render();
    });

    render();
  }
</script>

---
/**
 * ReviewsPage — página completa de opiniones.
 * Compartido por /opinie/, /en/reviews/ y /de/bewertungen/.
 */
import { type Locale, localeLink, t } from "~/lib/i18n";
import { getTotalReviews, reviewsForLocale } from "~/data/reviews";

import PageHero from "~/components/ui/PageHero.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import RatingSummary from "~/components/ui/RatingSummary.astro";
import Icon from "~/components/ui/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const total = getTotalReviews();
const items = reviewsForLocale(locale);

const months: Record<Locale, string[]> = {
  pl: ["sty", "lut", "mar", "kwi", "maj", "cze", "lip", "sie", "wrz", "paź", "lis", "gru"],
  en: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
  de: ["Jan", "Feb", "Mär", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"],
};

const fmtDate = (value: string) => {
  const [year, month] = value.split("-");
  return `${months[locale][Number(month) - 1] ?? month} ${year}`;
};

const copy: Record<
  Locale,
  {
    title: string;
    lead: string;
    allTitle: string;
    allLead: string;
    statsTitle: string;
    statReviews: string;
    statYears: string;
    statApartments: string;
    statCountries: string;
  }
> = {
  pl: {
    title: "Opinie gości Apartamentów Liberta",
    lead: "Nie zbieramy opinii na siłę i nie prosimy o nie przy wymeldowaniu. Wszystkie poniższe pochodzą z publicznych profili Booking.com i Google i można je zweryfikować.",
    allTitle: "Wszystkie opinie",
    allLead: "Zachowaliśmy oryginalne brzmienie wypowiedzi, wraz z językiem, w którym zostały napisane.",
    statsTitle: "Liberta w liczbach",
    statReviews: "opinii w serwisach",
    statYears: "lat gościny",
    statApartments: "apartamenty",
    statCountries: "kraje gości",
  },
  en: {
    title: "Guest reviews of Apartamenty Liberta",
    lead: "We do not chase reviews and we never ask for them at check-out. Everything below comes from public Booking.com and Google profiles and can be verified.",
    allTitle: "All reviews",
    allLead: "Wording is kept exactly as the guest wrote it, in the language they used.",
    statsTitle: "Liberta in numbers",
    statReviews: "reviews across platforms",
    statYears: "years hosting",
    statApartments: "apartments",
    statCountries: "guest countries",
  },
  de: {
    title: "Gästebewertungen von Apartamenty Liberta",
    lead: "Wir sammeln keine Bewertungen um jeden Preis und fragen beim Check-out nie danach. Alle folgenden stammen aus öffentlichen Booking.com- und Google-Profilen und sind überprüfbar.",
    allTitle: "Alle Bewertungen",
    allLead: "Der Wortlaut bleibt genau so, wie ihn der Gast geschrieben hat — in seiner Sprache.",
    statsTitle: "Liberta in Zahlen",
    statReviews: "Bewertungen auf Plattformen",
    statYears: "Jahre Gastgeber",
    statApartments: "Ferienwohnungen",
    statCountries: "Herkunftsländer",
  },
};

const c = copy[locale];

const stats = [
  { value: String(total), label: c.statReviews },
  { value: "6", label: c.statYears },
  { value: "4", label: c.statApartments },
  { value: "7", label: c.statCountries },
];
---

<PageHero
  eyebrow={tr.reviews.eyebrow}
  title={c.title}
  lead={c.lead}
  crumbs={[
    { name: tr.nav.home, href: localeLink(locale, "/") },
    { name: tr.reviews.eyebrow },
  ]}
/>

<!-- ============================================================== PUNTUACIONES -->
<section class="section section--tight">
  <div class="container">
    <div class="scores" data-reveal>
      <div class="scores__overall">
        <p class="scores__title">{tr.reviews.eyebrow}</p>
        <RatingSummary variant="dark" size={22} />
      </div>
    </div>

    <ul class="stats" role="list">
      {stats.map((stat, index) => (
        <li data-reveal style={`--reveal-delay:${index * 50}ms`}>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ================================================================== OPINIONES -->
<section class="section section--bg">
  <div class="container">
    <header class="rev-head" data-reveal>
      <span class="eyebrow">{tr.reviews.quotesTitle}</span>
      <h2 class="rev-head__title">{c.allTitle}</h2>
      <p class="lead">{c.allLead}</p>
    </header>

    <ul class="rev-list" role="list">
      {items.map((review, index) => (
        <li class="rev-item" data-reveal style={`--reveal-delay:${Math.min(index * 45, 250)}ms`}>
          <article>
            <div class="rev-item__head">
              <span class="rev-item__avatar" aria-hidden="true">{review.author.slice(0, 1)}</span>
              <div class="rev-item__who">
                <strong>{review.author}</strong>
                <span>
                  {review.country}
                  {review.stay ? ` · ${review.stay[locale]}` : ""}
                </span>
              </div>
              <div class="rev-item__score">
                {(review.rating / review.ratingScale * 10).toFixed(1).replace(".", ",")}
                <em>/10</em>
              </div>
            </div>

            <blockquote class="rev-item__text" lang={review.lang}>
              {review.text}
            </blockquote>

            <footer class="rev-item__foot">
              <span class:list={["rev-item__source", `rev-item__source--${review.source}`]}>
                {review.source === "booking" ? tr.reviews.sourceBooking : tr.reviews.sourceGoogle}
              </span>
              <time datetime={review.date}>{fmtDate(review.date)}</time>
            </footer>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<CtaBand title={tr.home.ctaBandTitle} text={tr.home.ctaBandText} note={tr.home.ctaBandNote} />

<style>
  /*
   * Bloque de puntuaciones.
   *
   * Es la tarjeta oscura que abre la página, así que tiene que llenar su ancho:
   * antes el contenido era una rejilla apretada a la izquierda y quedaba un
   * hueco vacío enorme a la derecha. Ahora el título va en su línea y las dos
   * plataformas se reparten con space-between.
   */
  .scores {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    border-radius: var(--radius-xl);
  }

  .scores__overall {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .scores__title {
    max-width: none;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--on-dark-text-muted);
  }

  /* Las dos plataformas separadas a los extremos, con la misma presencia */
  .scores__overall :global(.rsummary__list) {
    justify-content: space-between;
    gap: var(--space-6) var(--space-10);
  }

  .scores__overall :global(.rsummary__total) {
    padding-top: var(--space-4);
    border-top: 1px solid var(--on-dark-border);
  }
  /* Estadísticas */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .stats strong {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .stats span {
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Listado de opiniones */
  .rev-head {
    max-width: 46rem;
    margin-bottom: var(--space-10);
  }

  .rev-head__title {
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    font-size: var(--text-4xl);
  }

  .rev-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .rev-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .rev-item article {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    height: 100%;
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .rev-item__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rev-item__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-accent-faded);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .rev-item__who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
  }

  .rev-item__who strong {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .rev-item__who span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .rev-item__score {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .rev-item__score em {
    font-style: normal;
    font-size: 0.6em;
    color: var(--color-text-subtle);
  }

  .rev-item__text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-wrap: pretty;
  }

  .rev-item__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .rev-item__source {
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .rev-item__source--booking {
    background: #e8f0fa;
    color: #1b4f8f;
  }

  .rev-item__foot time {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
</style>

<script>
  /**
   * Retira la capa de "buscando" cuando el contenido está listo.
   *
   * El CSS ya la desvanece sola a los 1,2 s, así que esto no es imprescindible;
   * sirve para que la salida coincida con la carga real en lugar de con un
   * temporizador fijo. Si el script no corre, la página sigue viéndose.
   */
  const overlay = document.querySelector("[data-srch-overlay]");

  if (overlay) {
    const quitar = () => {
      overlay.setAttribute("hidden", "");
      overlay.setAttribute("aria-hidden", "true");
    };

    if (document.readyState === "complete") quitar();
    else window.addEventListener("load", quitar, { once: true });

    // Red de seguridad: pase lo que pase, nunca deja la capa tapando la página
    window.setTimeout(quitar, 3000);
  }
</script>

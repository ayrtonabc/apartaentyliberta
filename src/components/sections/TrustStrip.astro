---
/**
 * TrustStrip — solo las valoraciones de Booking.com y Google, centradas.
 * Sin pilares, sin titular y sin recuentos.
 */
import { type Locale, getLocaleFromUrl, t } from "~/lib/i18n";
import RatingSummary from "~/components/ui/RatingSummary.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);
---

<section class="trust" aria-label={tr.trust.verified}>
  <div class="container trust__inner">
    <RatingSummary size={22} showCounts={false} />
  </div>
</section>

<style>
  .trust {
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-5);
  }

  .trust__inner {
    display: flex;
    justify-content: center;
  }

  .trust__inner :global(.rsummary) {
    align-items: center;
  }

  .trust__inner :global(.rsummary__list) {
    justify-content: center;
    gap: var(--space-4) var(--space-8);
  }

  @media (max-width: 639px) {
    .trust {
      padding-block: var(--space-4);
    }

    .trust__inner :global(.rsummary__list) {
      gap: var(--space-4);
    }
  }
</style>

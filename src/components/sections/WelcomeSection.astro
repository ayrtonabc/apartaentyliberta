---
/**
 * WelcomeSection — bienvenida editorial de la portada.
 *
 * Usa exclusivamente las ocho fotos de `public/assets/witaj` en un grid 2×4,
 * con el texto a la derecha y la firma centrada debajo. No se mezcla ninguna
 * foto de `public/assets/facilities` ni de otras carpetas.
 */
import { type Locale, getLocaleFromUrl } from "~/lib/i18n";
import SmartImage from "~/components/ui/SmartImage.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);

const copy = {
  pl: {
    eyebrow: "Witaj na Mazurach",
    paragraphs: [
      "Wyobraź sobie poranne promienie mazurskiego słońca, delikatnie muskający twarz wiatr, a przed Tobą, jak na wyciągnięcie ręki, płynące po jeziorze niewielkie fale – takie rozpoczęcie dnia oferują Apartamenty na Mazurach Liberta.",
      "Gdy już się on zacznie, to do Twojej dyspozycji pozostawiamy luksusowy, klimatyzowany apartament, taras z bezpośrednim widokiem na jezioro, dwa pomosty, plażę, klasyczną góralską banię, grill, tereny zielone, pobliskie lasy, rejsy własną motorówką i wiele, wiele atrakcji regionu.",
      "A co gdy dzień chyli się ku końcowi? Spędzając czas w naszych apartamentach na Mazurach masz darmowy bilet na kolejny spektakl. Tym razem słońce powoli chowa się za jeziorem, rozświetlając niebo feerią barw i przepięknych gradientów, rysując na tafli wody gest pożegnania dnia.",
      "Tego wszystkiego możesz doświadczyć już niedługo. Wystarczy zrobić prosty krok. Wystarczy odwiedzić Apartamenty Liberta na Mazurach.",
    ],
    signatureAlt: "Zapraszamy — podpis Ani i Piotra Birbach",
    alts: [
      "Balia góralska z widokiem na jezioro o zachodzie słońca",
      "Stół na tarasie z widokiem na jezioro Szeląg",
      "Kajak na Jeziorze Szeląg o zachodzie słońca",
      "Stand-up paddle na Jeziorze Szeląg",
      "Siatkówka plażowa na plaży o zachodzie słońca",
      "Ognisko nad brzegiem jeziora",
      "Rejs motorówką Liberta po jeziorze",
      "Plac zabaw dla dzieci przy jeziorze",
    ],
  },
  en: {
    eyebrow: "Welcome to Masuria",
    paragraphs: [
      "Imagine the morning rays of the Masurian sun, a gentle breeze on your face, and small waves drifting across the lake just within reach — that is how a day begins at Apartamenty Liberta.",
      "Once it starts, you have a luxury air-conditioned apartment, a terrace with a direct lake view, two piers, a beach, a classic highland hot tub, a BBQ, green grounds, nearby forests, trips on the owner's motorboat and many more attractions of the region.",
      "And when the day draws to a close? Staying at our Masurian apartments gives you a free ticket to another performance. This time the sun slowly sets behind the lake, lighting the sky with a kaleidoscope of colours and gradients and drawing a farewell gesture on the water.",
      "You can experience all of this soon. It takes one simple step: visit Apartamenty Liberta in Masuria.",
    ],
    signatureAlt: "Zapraszamy — signature of Ania and Piotr Birbach",
    alts: [
      "Hot tub with a lake view at sunset",
      "Table on the terrace overlooking Lake Szeląg",
      "Kayak on Lake Szeląg at sunset",
      "Stand-up paddleboarding on Lake Szeląg",
      "Beach volleyball at sunset",
      "Fire pit by the lake",
      "Motorboat trip on the lake",
      "Children's playground by the lake",
    ],
  },
  de: {
    eyebrow: "Willkommen in Masuren",
    paragraphs: [
      "Stellen Sie sich die morgendlichen Strahlen der masurischen Sonne vor, einen sanften Wind auf dem Gesicht und vor Ihnen, zum Greifen nah, kleine Wellen auf dem See — so beginnt ein Tag in den Apartamenty Liberta.",
      "Wenn er beginnt, stehen Ihnen eine luxuriöse, klimatisierte Ferienwohnung, eine Terrasse mit direktem Seeblick, zwei Stege, ein Strand, ein klassischer Holz-Hot-Tub, ein Grill, grüne Flächen, nahe Wälder, eine Fahrt mit dem eigenen Motorboot des Eigentümers und viele weitere Attraktionen der Region zur Verfügung.",
      "Und wenn der Tag zu Ende geht? Wer Zeit in unseren masurischen Ferienwohnungen verbringt, bekommt eine Freikarte für die nächste Vorstellung. Diesmal versinkt die Sonne langsam hinter dem See, lässt den Himmel in einer Vielfalt von Farben und Verläufen leuchten und zeichnet eine Abschiedsgeste auf die Wasserfläche.",
      "All das können Sie bald erleben. Ein einfacher Schritt genügt: ein Besuch der Apartamenty Liberta in Masuren.",
    ],
    signatureAlt: "Zapraszamy — Unterschrift von Ania und Piotr Birbach",
    alts: [
      "Hot Tub mit Seeblick bei Sonnenuntergang",
      "Tisch auf der Terrasse mit Blick auf den Szeląg-See",
      "Kajak auf dem Szeląg-See bei Sonnenuntergang",
      "Stand-up-Paddling auf dem Szeląg-See",
      "Beachvolleyball bei Sonnenuntergang",
      "Feuerstelle am Seeufer",
      "Motorbootfahrt auf dem See",
      "Spielplatz für Kinder am See",
    ],
  },
}[locale];

const photos = [
  { src: "/assets/witaj/balia.webp", index: 0 },
  { src: "/assets/witaj/taras.webp", index: 1 },
  { src: "/assets/witaj/jezioro-szelag.webp", index: 2 },
  { src: "/assets/witaj/lake.webp", index: 3 },
  { src: "/assets/witaj/play.webp", index: 4 },
  { src: "/assets/witaj/miejsce-na-ognisko.webp", index: 5 },
  { src: "/assets/witaj/rejs-motorowka.webp", index: 6 },
  { src: "/assets/witaj/plac-zabaw.webp", index: 7 },
];
---

<section class="welcome section" id="witaj" aria-labelledby="welcome-title">
  <div class="container">
    <div class="welcome__grid">
      <div class="welcome__collage" data-reveal>
        <span class="welcome__wave welcome__wave--back" aria-hidden="true"></span>
        <span class="welcome__wave welcome__wave--front" aria-hidden="true"></span>

        {photos.map((photo) => (
          <figure class="welcome__shot">
            <SmartImage
              src={photo.src}
              alt={copy.alts[photo.index]}
              sizes="(min-width: 1024px) 22vw, 46vw"
            />
          </figure>
        ))}
      </div>

      <div class="welcome__copy" data-reveal style="--reveal-delay:90ms">
        <h2 class="eyebrow welcome__eyebrow" id="welcome-title">{copy.eyebrow}</h2>

        <div class="welcome__prose">
          {copy.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 && "welcome__lead"]}>{paragraph}</p>
          ))}
        </div>

        <div class="welcome__signature-block">
          <img
            class="welcome__signature"
            src="/assets/branding/podpis.png"
            alt={copy.signatureAlt}
            width="292"
            height="74"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 86% 8%, rgba(176, 141, 74, 0.12), transparent 60%),
      linear-gradient(180deg, #f7f3e7 0%, #eef2e3 100%);
  }

  .welcome::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1120px, calc(100% - 3rem));
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-brass), transparent);
    opacity: 0.45;
    transform: translateX(-50%);
  }

  .welcome__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .welcome__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  /* ------------------------------------------------------------- Collage */

  .welcome__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: var(--space-3);
    isolation: isolate;
    padding-block: var(--space-2);
  }

  .welcome__wave {
    position: absolute;
    z-index: 0;
    display: block;
    background: #cfe5ef;
    border-radius: 48% 52% 56% 44% / 54% 46% 54% 46%;
    pointer-events: none;
  }

  .welcome__wave--back {
    top: 3%;
    right: 0;
    width: 34%;
    height: 52%;
    transform: rotate(-14deg);
    opacity: 0.85;
  }

  .welcome__wave--front {
    bottom: 0;
    left: 0;
    width: 26%;
    height: 30%;
    transform: rotate(12deg);
    opacity: 0.7;
  }

  .welcome__shot {
    position: relative;
    z-index: 1;
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-muted);
    box-shadow: 0 18px 34px -24px rgba(14, 26, 21, 0.4);
  }

  .welcome__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --------------------------------------------------------------- Copy */

  .welcome__copy {
    max-width: 40rem;
  }

  /* Misma tipografía que los eyebrows del resto de secciones. */
  .welcome__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .welcome__prose {
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: 1.72;
    color: var(--color-text-muted);
  }

  .welcome__prose p {
    max-width: none;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }

  .welcome__prose p:last-child {
    margin-bottom: 0;
  }

  .welcome__lead {
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: 1.62;
  }

  .welcome__lead::first-letter {
    float: left;
    padding-right: 0.08em;
    font-family: var(--font-display);
    font-size: 3.2em;
    line-height: 0.78;
    color: var(--color-accent);
  }

  .welcome__signature-block {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  .welcome__signature {
    display: block;
    width: clamp(11rem, 20vw, 16rem);
    height: auto;
    background: transparent;
    opacity: 0.9;
  }

  @media (max-width: 479px) {
    .welcome__collage {
      gap: var(--space-2);
    }
  }
</style>

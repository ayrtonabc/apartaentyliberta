---
/**
 * WelcomeSection — bienvenida editorial de la portada.
 *
 * Un carrusel automático (3 s) con las ocho fotos de `public/assets/witaj`.
 * Sustituye el mosaico 2×4, que resultaba cargado. Mantiene el texto a la
 * derecha, la firma centrada y el fondo cálido.
 */
import { type Locale, getLocaleFromUrl } from "~/lib/i18n";
import SmartImage from "~/components/ui/SmartImage.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);

const copy = {
  pl: {
    eyebrow: "Witaj na Mazurach",
    paragraphs: [
      "Wyobraź sobie poranne promienie mazurskiego słońca, delikatnie muskający twarz wiatr, a przed Tobą, jak na wyciągnięcie ręki, płynące po jeziorze niewielkie fale – takie rozpoczęcie dnia oferują Apartamenty na Mazurach Liberta.",
      "Gdy już się on zacznie, to do Twojej dyspozycji pozostawiamy luksusowy, klimatyzowany apartament, taras z bezpośrednim widokiem na jezioro, dwa pomosty, plażę, klasyczną góralską banię, grill, tereny zielone, pobliskie lasy, rejsy własną motorówką i wiele, wiele atrakcji regionu.",
      "A co gdy dzień chyli się ku końcowi? Spędzając czas w naszych apartamentach na Mazurach masz darmowy bilet na kolejny spektakl. Tym razem słońce powoli chowa się za jeziorem, rozświetlając niebo feerią barw i przepięknych gradientów, rysując na tafli wody gest pożegnania dnia.",
      "Tego wszystkiego możesz doświadczyć już niedługo. Wystarczy zrobić prosty krok. Wystarczy odwiedzić Apartamenty Liberta na Mazurach.",
    ],
    signatureAlt: "Zapraszamy — podpis Ani i Piotra Birbach",
    alts: [
      "Balia góralska z widokiem na jezioro o zachodzie słońca",
      "Stół na tarasie z widokiem na jezioro Szeląg",
      "Kajak na Jeziorze Szeląg o zachodzie słońca",
      "Stand-up paddle na Jeziorze Szeląg",
      "Siatkówka plażowa na plaży o zachodzie słońca",
      "Ognisko nad brzegiem jeziora",
      "Rejs motorówką Liberta po jeziorze",
      "Plac zabaw dla dzieci przy jeziorze",
    ],
    carouselLabel: "Zdjęcia Apartamentów Liberta",
    pause: "Pauza",
    play: "Wznów",
  },
  en: {
    eyebrow: "Welcome to Masuria",
    paragraphs: [
      "Imagine the morning rays of the Masurian sun, a gentle breeze on your face, and small waves drifting across the lake just within reach — that is how a day begins at Apartamenty Liberta.",
      "Once it starts, you have a luxury air-conditioned apartment, a terrace with a direct lake view, two piers, a beach, a classic highland hot tub, a BBQ, green grounds, nearby forests, trips on the owner's motorboat and many more attractions of the region.",
      "And when the day draws to a close? Staying at our Masurian apartments gives you a free ticket to another performance. This time the sun slowly sets behind the lake, lighting the sky with a kaleidoscope of colours and gradients and drawing a farewell gesture on the water.",
      "You can experience all of this soon. It takes one simple step: visit Apartamenty Liberta in Masuria.",
    ],
    signatureAlt: "Zapraszamy — signature of Ania and Piotr Birbach",
    alts: [
      "Hot tub with a lake view at sunset",
      "Table on the terrace overlooking Lake Szeląg",
      "Kayak on Lake Szeląg at sunset",
      "Stand-up paddleboarding on Lake Szeląg",
      "Beach volleyball at sunset",
      "Fire pit by the lake",
      "Motorboat trip on the lake",
      "Children's playground by the lake",
    ],
    carouselLabel: "Photos of Apartamenty Liberta",
    pause: "Pause",
    play: "Resume",
  },
  de: {
    eyebrow: "Willkommen in Masuren",
    paragraphs: [
      "Stellen Sie sich die morgendlichen Strahlen der masurischen Sonne vor, einen sanften Wind auf dem Gesicht und vor Ihnen, zum Greifen nah, kleine Wellen auf dem See — so beginnt ein Tag in den Apartamenty Liberta.",
      "Wenn er beginnt, stehen Ihnen eine luxuriöse, klimatisierte Ferienwohnung, eine Terrasse mit direktem Seeblick, zwei Stege, ein Strand, ein klassischer Holz-Hot-Tub, ein Grill, grüne Flächen, nahe Wälder, eine Fahrt mit dem eigenen Motorboot des Eigentümers und viele weitere Attraktionen der Region zur Verfügung.",
      "Und wenn der Tag zu Ende geht? Wer Zeit in unseren masurischen Ferienwohnungen verbringt, bekommt eine Freikarte für die nächste Vorstellung. Diesmal versinkt die Sonne langsam hinter dem See, lässt den Himmel in einer Vielfalt von Farben und Verläufen leuchten und zeichnet eine Abschiedsgeste auf die Wasserfläche.",
      "All das können Sie bald erleben. Ein einfacher Schritt genügt: ein Besuch der Apartamenty Liberta in Masuren.",
    ],
    signatureAlt: "Zapraszamy — Unterschrift von Ania und Piotr Birbach",
    alts: [
      "Hot Tub mit Seeblick bei Sonnenuntergang",
      "Tisch auf der Terrasse mit Blick auf den Szeląg-See",
      "Kajak auf dem Szeląg-See bei Sonnenuntergang",
      "Stand-up-Paddling auf dem Szeląg-See",
      "Beachvolleyball bei Sonnenuntergang",
      "Feuerstelle am Seeufer",
      "Motorbootfahrt auf dem See",
      "Spielplatz für Kinder am See",
    ],
    carouselLabel: "Fotos der Apartamenty Liberta",
    pause: "Pause",
    play: "Weiter",
  },
}[locale];

const photos = [
  { src: "/assets/witaj/balia.webp", index: 0 },
  { src: "/assets/witaj/taras.webp", index: 1 },
  { src: "/assets/witaj/jezioro-szelag.webp", index: 2 },
  { src: "/assets/witaj/lake.webp", index: 3 },
  { src: "/assets/witaj/play.webp", index: 4 },
  { src: "/assets/witaj/miejsce-na-ognisko.webp", index: 5 },
  { src: "/assets/witaj/rejs-motorowka.webp", index: 6 },
  { src: "/assets/witaj/plac-zabaw.webp", index: 7 },
];
---

<section class="welcome section" id="witaj" aria-labelledby="welcome-title">
  <div class="container">
    <div class="welcome__grid">
      <div
        class="welcome__carousel"
        data-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label={copy.carouselLabel}
      >
        <div class="welcome__track">
          {photos.map((photo, index) => (
            <figure
              class:list={["welcome__slide", index === 0 && "is-active"]}
              data-slide
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <SmartImage
                src={photo.src}
                alt={copy.alts[photo.index]}
                sizes="(min-width: 900px) 46vw, 92vw"
                priority={index === 0}
              />
            </figure>
          ))}
        </div>

        <div class="welcome__controls">
          <div class="welcome__dots" role="group" aria-label={copy.carouselLabel}>
            {photos.map((_, index) => (
              <button
                class:list={["welcome__dot", index === 0 && "is-active"]}
                type="button"
                data-carousel-dot
                aria-label={`${index + 1} / ${photos.length}`}
                aria-current={index === 0 ? "true" : "false"}
              ></button>
            ))}
          </div>
        </div>

        <button
          class="welcome__pause"
          type="button"
          data-carousel-toggle
          data-play-label={copy.play}
          aria-pressed="false"
        >
          {copy.pause}
        </button>
      </div>

      <div class="welcome__copy" data-reveal style="--reveal-delay:90ms">
        <img
          class="welcome__heart"
          src="/assets/witaj/vectorcorazon.svg"
          alt=""
          width="1462"
          height="1591"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <h2 class="eyebrow welcome__eyebrow" id="welcome-title">{copy.eyebrow}</h2>

        <div class="welcome__prose">
          {copy.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 && "welcome__lead"]}>{paragraph}</p>
          ))}
        </div>

        <div class="welcome__signature-block">
          <img
            class="welcome__signature"
            src="/assets/branding/podpis.png"
            alt={copy.signatureAlt}
            width="292"
            height="74"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 86% 8%, rgba(176, 141, 74, 0.12), transparent 60%),
      linear-gradient(180deg, #f7f3e7 0%, #eef2e3 100%);
  }

  .welcome::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1120px, calc(100% - 3rem));
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-brass), transparent);
    opacity: 0.45;
    transform: translateX(-50%);
  }

  .welcome__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .welcome__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(2.5rem, 4vw, 3.75rem);
    }
  }

  /* ------------------------------------------------------------ Carrusel */

  .welcome__carousel {
    position: relative;
    isolation: isolate;
  }

  .welcome__carousel::before {
    content: "";
    position: absolute;
    top: 6%;
    right: -4%;
    width: 34%;
    height: 58%;
    z-index: -1;
    background: #cfe5ef;
    border-radius: 48% 52% 56% 44% / 54% 46% 54% 46%;
    transform: rotate(-12deg);
    opacity: 0.8;
  }

  .welcome__track {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-bg-muted);
    box-shadow: 0 26px 55px -30px rgba(14, 26, 21, 0.45);
  }

  .welcome__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
    pointer-events: none;
  }

  .welcome__slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .welcome__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform-origin: 50% 52%;
  }

  /* Zoom lento mientras la foto está visible; se reinicia en cada slide. */
  .welcome__slide.is-active :global(img) {
    animation: welcome-zoom 3.2s linear both;
  }

  @keyframes welcome-zoom {
    from {
      transform: scale(1.01);
    }
    to {
      transform: scale(1.09);
    }
  }

  .welcome__controls {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  .welcome__controls > * {
    pointer-events: auto;
  }

  .welcome__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 10px;
    background: rgba(6, 14, 11, 0.5);
    border-radius: var(--radius-full);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .welcome__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    background: rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-full);
    transition: width var(--transition-base), background-color var(--transition-base);
  }

  .welcome__dot.is-active {
    width: 18px;
    background: #fff;
  }

  /*
   * La pausa no se muestra sobre la foto. Se mantiene operativa para lectores
   * de pantalla y aparece solo cuando recibe foco con teclado, de modo que el
   * carrusel sigue teniendo un mecanismo de pausa accesible.
   */
  .welcome__pause {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .welcome__pause:focus-visible {
    width: auto;
    height: auto;
    min-height: 2.25rem;
    margin: 0;
    padding: 0 var(--space-3);
    overflow: visible;
    clip: auto;
    color: #fff;
    background: rgba(6, 14, 11, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-full);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* --------------------------------------------------------------- Copy */

  .welcome__copy {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  /*
   * Corazón vectorial del propietario, detrás del texto. Es un SVG de 2 KB,
   * no una foto: acompaña sin pesar y sin tapar la lectura.
   */
  .welcome__heart {
    position: absolute;
    top: 6%;
    right: -26%;
    z-index: -1;
    width: min(58rem, 142%);
    height: auto;
    max-width: none;
    background: transparent;
    opacity: 0.58;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 899px) {
    .welcome__heart {
      top: 9%;
      right: -34%;
      width: 150%;
      opacity: 0.45;
    }
  }

  .welcome__eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .welcome__prose {
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: 1.72;
    color: var(--color-text-muted);
  }

  .welcome__prose p {
    max-width: none;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }

  .welcome__prose p:last-child {
    margin-bottom: 0;
  }

  .welcome__lead {
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: 1.62;
  }

  .welcome__lead::first-letter {
    float: left;
    padding-right: 0.08em;
    font-family: var(--font-display);
    font-size: 3.2em;
    line-height: 0.78;
    color: var(--color-accent);
  }

  .welcome__signature-block {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  .welcome__signature {
    display: block;
    width: clamp(11rem, 20vw, 16rem);
    height: auto;
    background: transparent;
    opacity: 0.9;
  }

  @media (max-width: 479px) {
    .welcome__controls {
      left: var(--space-3);
      right: var(--space-3);
      bottom: var(--space-3);
    }

    .welcome__dots {
      gap: 4px;
      padding: 6px 8px;
    }

    .welcome__dot {
      width: 5px;
      height: 5px;
    }

    .welcome__dot.is-active {
      width: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome__slide {
      transition: none;
    }

    .welcome__slide.is-active :global(img) {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-carousel-toggle]");
    if (slides.length < 2) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0;
    let timer: number | undefined;
    let userPaused = false;

    const show = (nextIndex: number) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === index);
        dot.setAttribute("aria-current", i === index ? "true" : "false");
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (reduced || userPaused || document.hidden) return;
      timer = window.setInterval(() => show(index + 1), 3000);
    };

    const pauseLabel = toggle?.textContent?.trim() || "Pause";
    const playLabel = toggle?.dataset.playLabel || "Resume";

    const setPaused = (paused: boolean) => {
      userPaused = paused;
      if (toggle) {
        toggle.setAttribute("aria-pressed", String(paused));
        toggle.textContent = paused ? playLabel : pauseLabel;
      }
      if (paused) stop();
      else start();
    };

    dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));

    if (toggle) {
      if (reduced) toggle.hidden = true;
      toggle.addEventListener("click", () => setPaused(!userPaused));
    }

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget as Node)) start();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    show(0);
    start();
  });
</script>

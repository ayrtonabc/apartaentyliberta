---
/**
 * WelcomeSection — bienvenida editorial de la portada.
 *
 * Vuelve al planteamiento cálido de la web anterior: dos fotos superpuestas
 * con una forma de agua detrás, texto a la derecha y la firma de los
 * propietarios. No usa el mosaico de cuatro fotos de instalaciones (el cliente
 * pidió expresamente no mostrar `apartament-z-zewnatrz`, `salon-z-kominkiem`,
 * `kuchnia` ni `jadalnia` aquí).
 */
import { type Locale, getLocaleFromUrl, localeLink } from "~/lib/i18n";
import Icon from "~/components/ui/Icon.astro";
import SmartImage from "~/components/ui/SmartImage.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);

const copy = {
  pl: {
    eyebrow: "Mazury",
    title: "Witaj na Mazurach",
    paragraphs: [
      "Wyobraź sobie poranne promienie mazurskiego słońca, delikatnie muskający twarz wiatr, a przed Tobą, jak na wyciągnięcie ręki, płynące po jeziorze niewielkie fale – takie rozpoczęcie dnia oferują Apartamenty na Mazurach Liberta.",
      "Gdy już się on zacznie, to do Twojej dyspozycji pozostawiamy luksusowy, klimatyzowany apartament, taras z bezpośrednim widokiem na jezioro, dwa pomosty, plażę, klasyczną góralską banię, grill, tereny zielone, pobliskie lasy, rejsy własną motorówką i wiele, wiele atrakcji regionu.",
      "A co gdy dzień chyli się ku końcowi? Spędzając czas w naszych apartamentach na Mazurach masz darmowy bilet na kolejny spektakl. Tym razem słońce powoli chowa się za jeziorem, rozświetlając niebo feerią barw i przepięknych gradientów, rysując na tafli wody gest pożegnania dnia.",
      "Tego wszystkiego możesz doświadczyć już niedługo. Wystarczy zrobić prosty krok. Wystarczy odwiedzić Apartamenty Liberta na Mazurach.",
    ],
    cta: "Zobacz apartamenty",
    signatureAlt: "Zapraszamy — podpis Ani i Piotra Birbach",
    signatureCaption: "Ania i Piotr · gospodarze Liberta",
    mainAlt: "Balia góralska z widokiem na jezioro o zachodzie słońca",
    smallAlt: "Stół na tarasie z widokiem na jezioro Szeląg",
  },
  en: {
    eyebrow: "Masuria",
    title: "Welcome to Masuria",
    paragraphs: [
      "Imagine the morning rays of the Masurian sun, a gentle breeze on your face, and small waves drifting across the lake just within reach — that is how a day begins at Apartamenty Liberta.",
      "Once it starts, you have a luxury air-conditioned apartment, a terrace with a direct lake view, two piers, a beach, a classic highland hot tub, a BBQ, green grounds, nearby forests, trips on the owner's motorboat and many more attractions of the region.",
      "And when the day draws to a close? Staying at our Masurian apartments gives you a free ticket to another performance. This time the sun slowly sets behind the lake, lighting the sky with a kaleidoscope of colours and gradients and drawing a farewell gesture on the water.",
      "You can experience all of this soon. It takes one simple step: visit Apartamenty Liberta in Masuria.",
    ],
    cta: "See the apartments",
    signatureAlt: "Zapraszamy — signature of Ania and Piotr Birbach",
    signatureCaption: "Ania and Piotr · your hosts at Liberta",
    mainAlt: "Hot tub with a lake view at sunset",
    smallAlt: "Table on the terrace overlooking Lake Szeląg",
  },
  de: {
    eyebrow: "Masuren",
    title: "Willkommen in Masuren",
    paragraphs: [
      "Stellen Sie sich die morgendlichen Strahlen der masurischen Sonne vor, einen sanften Wind auf dem Gesicht und vor Ihnen, zum Greifen nah, kleine Wellen auf dem See — so beginnt ein Tag in den Apartamenty Liberta.",
      "Wenn er beginnt, stehen Ihnen eine luxuriöse, klimatisierte Ferienwohnung, eine Terrasse mit direktem Seeblick, zwei Stege, ein Strand, ein klassischer Holz-Hot-Tub, ein Grill, grüne Flächen, nahe Wälder, eine Fahrt mit dem eigenen Motorboot des Eigentümers und viele weitere Attraktionen der Region zur Verfügung.",
      "Und wenn der Tag zu Ende geht? Wer Zeit in unseren masurischen Ferienwohnungen verbringt, bekommt eine Freikarte für die nächste Vorstellung. Diesmal versinkt die Sonne langsam hinter dem See, lässt den Himmel in einer Vielfalt von Farben und Verläufen leuchten und zeichnet eine Abschiedsgeste auf die Wasserfläche.",
      "All das können Sie bald erleben. Ein einfacher Schritt genügt: ein Besuch der Apartamenty Liberta in Masuren.",
    ],
    cta: "Ferienwohnungen ansehen",
    signatureAlt: "Zapraszamy — Unterschrift von Ania und Piotr Birbach",
    signatureCaption: "Ania und Piotr · Ihre Gastgeber in Liberta",
    mainAlt: "Hot Tub mit Seeblick bei Sonnenuntergang",
    smallAlt: "Tisch auf der Terrasse mit Blick auf den Szeląg-See",
  },
}[locale];
---

<section class="welcome section" id="witaj" aria-labelledby="welcome-title">
  <div class="container">
    <div class="welcome__grid">
      <div class="welcome__collage" data-reveal>
        <span class="welcome__wave welcome__wave--back" aria-hidden="true"></span>
        <span class="welcome__wave welcome__wave--front" aria-hidden="true"></span>

        <figure class="welcome__shot welcome__shot--main">
          <SmartImage
            src="/assets/facilities/balia.webp"
            alt={copy.mainAlt}
            sizes="(min-width: 1024px) 38vw, 88vw"
          />
        </figure>

        <figure class="welcome__shot welcome__shot--small">
          <SmartImage
            src="/assets/facilities/taras.webp"
            alt={copy.smallAlt}
            sizes="(min-width: 1024px) 24vw, 56vw"
          />
        </figure>
      </div>

      <div class="welcome__copy" data-reveal style="--reveal-delay:90ms">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2 class="welcome__title" id="welcome-title">{copy.title}</h2>

        <div class="welcome__prose">
          {copy.paragraphs.map((paragraph, index) => (
            <p class:list={[index === 0 && "welcome__lead"]}>{paragraph}</p>
          ))}
        </div>

        <div class="welcome__signature-block">
          <img
            class="welcome__signature"
            src="/assets/branding/podpis.png"
            alt={copy.signatureAlt}
            width="292"
            height="74"
            loading="lazy"
            decoding="async"
          />
          <span class="welcome__signature-caption">{copy.signatureCaption}</span>
        </div>

        <a class="welcome__cta" href={localeLink(locale, "/apartamenty/")}>
          {copy.cta}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 86% 8%, rgba(176, 141, 74, 0.12), transparent 60%),
      linear-gradient(180deg, #f7f3e7 0%, #eef2e3 100%);
  }

  .welcome::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1120px, calc(100% - 3rem));
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-brass), transparent);
    opacity: 0.45;
    transform: translateX(-50%);
  }

  .welcome__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .welcome__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  /* ------------------------------------------------------------- Collage */

  .welcome__collage {
    position: relative;
    min-height: 27rem;
    isolation: isolate;
  }

  @media (min-width: 900px) {
    .welcome__collage {
      min-height: clamp(30rem, 44vw, 38rem);
    }
  }

  .welcome__wave {
    position: absolute;
    display: block;
    background: #cfe5ef;
    border-radius: 48% 52% 56% 44% / 54% 46% 54% 46%;
    pointer-events: none;
  }

  .welcome__wave--back {
    top: 6%;
    right: 5%;
    width: 38%;
    height: 54%;
    transform: rotate(-14deg);
    opacity: 0.9;
  }

  .welcome__wave--front {
    bottom: 7%;
    left: 4%;
    width: 30%;
    height: 34%;
    transform: rotate(12deg);
    opacity: 0.75;
  }

  .welcome__shot {
    position: absolute;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-muted);
    box-shadow: 0 24px 50px -28px rgba(14, 26, 21, 0.45);
  }

  .welcome__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .welcome__shot--main {
    top: 0;
    left: 6%;
    z-index: 2;
    width: 76%;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }

  .welcome__shot--small {
    left: 0;
    bottom: 0;
    z-index: 3;
    width: 43%;
    aspect-ratio: 3 / 4;
    border: 7px solid #f8f3e7;
    border-radius: 4px;
  }

  /* --------------------------------------------------------------- Copy */

  .welcome__copy {
    max-width: 40rem;
  }

  .welcome__title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
    font-size: clamp(1.95rem, 3.8vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .welcome__prose {
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: 1.72;
    color: var(--color-text-muted);
  }

  .welcome__prose p {
    max-width: none;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }

  .welcome__prose p:last-child {
    margin-bottom: 0;
  }

  .welcome__lead {
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: 1.62;
  }

  .welcome__lead::first-letter {
    float: left;
    padding-right: 0.08em;
    font-family: var(--font-display);
    font-size: 3.2em;
    line-height: 0.78;
    color: var(--color-accent);
  }

  .welcome__signature-block {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .welcome__signature {
    display: block;
    width: clamp(7rem, 11vw, 9.5rem);
    height: auto;
    background: transparent;
    opacity: 0.88;
  }

  .welcome__signature-caption {
    max-width: 15rem;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .welcome__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    margin-top: var(--space-6);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .welcome__cta:hover {
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .welcome__collage {
      min-height: 25rem;
    }

    .welcome__shot--main {
      left: 8%;
      width: 74%;
    }

    .welcome__shot--small {
      width: 42%;
    }
  }

  @media (max-width: 479px) {
    .welcome__collage {
      min-height: 20rem;
    }

    .welcome__shot--main {
      left: 6%;
      width: 80%;
    }

    .welcome__shot--small {
      width: 45%;
      border-width: 5px;
    }
  }
</style>

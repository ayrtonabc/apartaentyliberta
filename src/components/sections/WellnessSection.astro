---
/**
 * WellnessSection — sauna, balia y ognisko en la portada.
 *
 * Las siete fotos son las que entregó el propietario para esta sección
 * (`zdjecia sauna ogniski`). No se mezclan con las fotos del mosaico de
 * instalaciones: aquí manda el producto real, en un mosaico editorial.
 *
 * La sauna se describe como “na życzenie”, que es como funciona: no se vende
 * como incluida si no lo está.
 */
import { type Locale, getLocaleFromUrl, localeLink } from "~/lib/i18n";
import { bookingUrl } from "~/data/booking";
import Icon from "~/components/ui/Icon.astro";
import SmartImage from "~/components/ui/SmartImage.astro";

const locale: Locale = getLocaleFromUrl(Astro.url);

const copy = {
  pl: {
    eyebrow: "Sauna i ogień",
    title: "Sauna, balia i ogień nad jeziorem",
    lead: "Po dniu nad jeziorem wracacie do własnej balii, a wieczorem do sauny z widokiem na wodę. Obok jest miejsce na ognisko — z drewnem, ławkami i jeziorem w tle.",
    features: [
      {
        icon: "flame" as const,
        title: "Balia napalana drewnem",
        text: "Prywatna, podgrzewana codziennie. Drewno czeka przygotowane przy balii.",
      },
      {
        icon: "waves" as const,
        title: "Sauna beczkowa",
        text: "Przeszklona, z widokiem na jezioro. Udostępniana na życzenie, codziennie 10–22.",
      },
      {
        icon: "firepit" as const,
        title: "Ognisko i grill",
        text: "Wspólne miejsce na ognisko z ławkami i widokiem na wodę. Drewno przygotowane.",
      },
      {
        icon: "tree" as const,
        title: "Las za płotem",
        text: "Strefa Natura 2000, 105 m do brzegu, dwa pomosty i plaża dla gości.",
      },
    ],
    note: "Sauna jest udostępniana na życzenie. Balia górska i drewno do ogniska są w cenie pobytu.",
    cta: "Sprawdź dostępność",
    link: "Zobacz wszystkie udogodnienia",
    captions: [
      "Sauna · lato",
      "Sauna · lato",
      "Sauna · zima",
      "Sauna i balia · wieczór",
      "Sauna · zachód słońca",
      "Ognisko · zachód słońca",
      "Ognisko nad jeziorem",
    ],
    alts: [
      "Wnętrze sauny beczkowej latem z widokiem na jezioro Szeląg",
      "Sauna beczkowa od środka, widok na pomost i jezioro",
      "Sauna zimą z widokiem na zaśnieżone jezioro",
      "Sauna i balia wieczorem w ogrodzie Apartamentów Liberta",
      "Sauna beczkowa o zachodzie słońca nad jeziorem",
      "Ognisko nad jeziorem o zachodzie słońca",
      "Miejsce na ognisko na trawie przy jeziorze",
    ],
  },
  en: {
    eyebrow: "Sauna and fire",
    title: "Sauna, hot tub and fire by the lake",
    lead: "After a day on the lake you come back to your own hot tub, and in the evening to a sauna with a view of the water. Next to it is the fire pit — with wood, benches and the lake behind.",
    features: [
      {
        icon: "flame" as const,
        title: "Wood-fired hot tub",
        text: "Private, heated every day. Firewood is left ready beside it.",
      },
      {
        icon: "waves" as const,
        title: "Barrel sauna",
        text: "Glazed, looking out over the lake. Available on request, daily 10am–10pm.",
      },
      {
        icon: "firepit" as const,
        title: "Fire pit and BBQ",
        text: "A shared fire pit with benches and a view of the water. Firewood provided.",
      },
      {
        icon: "tree" as const,
        title: "Forest at the fence",
        text: "Natura 2000 area, 105 m to the shore, two piers and a beach for guests.",
      },
    ],
    note: "The sauna is available on request. The hot tub and firewood are included in your stay.",
    cta: "Check availability",
    link: "See all facilities",
    captions: [
      "Sauna · summer",
      "Sauna · summer",
      "Sauna · winter",
      "Sauna and hot tub · evening",
      "Sauna · sunset",
      "Fire pit · sunset",
      "Fire pit by the lake",
    ],
    alts: [
      "Interior of the barrel sauna in summer with a view of Lake Szeląg",
      "Barrel sauna from inside, looking out to the pier and lake",
      "Sauna in winter with a view of the snow-covered lake",
      "Sauna and hot tub in the evening in the Liberta garden",
      "Barrel sauna at sunset by the lake",
      "Fire pit by the lake at sunset",
      "Fire pit on the lawn by the lake",
    ],
  },
  de: {
    eyebrow: "Sauna und Feuer",
    title: "Sauna, Hot Tub und Feuer am See",
    lead: "Nach einem Tag am See kommt ihr in euren eigenen Hot Tub zurück und abends in eine Sauna mit Blick aufs Wasser. Daneben liegt die Feuerstelle — mit Holz, Bänken und dem See im Hintergrund.",
    features: [
      {
        icon: "flame" as const,
        title: "Holzbeheizter Hot Tub",
        text: "Privat, täglich beheizt. Das Brennholz liegt bereit.",
      },
      {
        icon: "waves" as const,
        title: "Fasssauna",
        text: "Verglast, mit Blick auf den See. Auf Anfrage, täglich 10–22 Uhr.",
      },
      {
        icon: "firepit" as const,
        title: "Feuerstelle und Grill",
        text: "Gemeinsame Feuerstelle mit Bänken und Blick aufs Wasser. Brennholz wird gestellt.",
      },
      {
        icon: "tree" as const,
        title: "Wald direkt am Zaun",
        text: "Natura-2000-Gebiet, 105 m zum Ufer, zwei Stege und ein Strand für Gäste.",
      },
    ],
    note: "Die Sauna wird auf Anfrage bereitgestellt. Hot Tub und Brennholz sind im Aufenthalt enthalten.",
    cta: "Verfügbarkeit prüfen",
    link: "Alle Ausstattung ansehen",
    captions: [
      "Sauna · Sommer",
      "Sauna · Sommer",
      "Sauna · Winter",
      "Sauna und Hot Tub · Abend",
      "Sauna · Sonnenuntergang",
      "Feuerstelle · Sonnenuntergang",
      "Feuerstelle am See",
    ],
    alts: [
      "Innenraum der Fasssauna im Sommer mit Blick auf den Szeląg-See",
      "Fasssauna von innen mit Blick auf Steg und See",
      "Sauna im Winter mit Blick auf den verschneiten See",
      "Sauna und Hot Tub am Abend im Garten von Apartamenty Liberta",
      "Fasssauna bei Sonnenuntergang am See",
      "Feuerstelle am See bei Sonnenuntergang",
      "Feuerstelle auf der Wiese am See",
    ],
  },
}[locale];

const photos = [
  { src: "/assets/wellness/sauna-wnetrze-lato.webp", index: 0, size: "big" as const },
  { src: "/assets/wellness/sauna-wnetrze-lato-2.webp", index: 1 },
  { src: "/assets/wellness/sauna-wnetrze-zima.webp", index: 2 },
  { src: "/assets/wellness/sauna-ogrod-wieczor.webp", index: 3 },
  { src: "/assets/wellness/sauna-beczka-zachod.webp", index: 4 },
  { src: "/assets/wellness/ognisko-zachod.webp", index: 5, size: "wide" as const },
  { src: "/assets/wellness/ognisko-laka.webp", index: 6, size: "wide" as const },
];
---

<section class="wellness section" id="wellness" aria-labelledby="wellness-title">
  <div class="container">
    <header class="wellness__head">
      <div class="wellness__copy" data-reveal>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2 class="wellness__title" id="wellness-title">{copy.title}</h2>
        <p class="wellness__lead">{copy.lead}</p>
        <p class="wellness__note">{copy.note}</p>

        <div class="wellness__actions">
          <a
            class="btn btn--primary"
            href={bookingUrl(locale)}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.cta}
          </a>
          <a class="wellness__link" href={localeLink(locale, "/apartamenty/")}>
            {copy.link}
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <ul class="wellness__features" role="list" data-reveal style="--reveal-delay:80ms">
        {copy.features.map((feature) => (
          <li>
            <span class="wellness__icon"><Icon name={feature.icon} size={19} /></span>
            <span>
              <strong>{feature.title}</strong>
              <small>{feature.text}</small>
            </span>
          </li>
        ))}
      </ul>
    </header>

    <div class="wellness__gallery" data-reveal>
      {photos.map((photo, i) => (
        <figure class:list={["wellness__shot", photo.size && `wellness__shot--${photo.size}`]}>
          <SmartImage
            src={photo.src}
            alt={copy.alts[photo.index]}
            sizes={photo.size === "big" ? "(min-width: 1024px) 48vw, 100vw" : "(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 100vw"}
          />
          <figcaption class="wellness__caption">{copy.captions[photo.index]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .wellness {
    background: var(--color-bg);
  }

  .wellness__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .wellness__head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .wellness__copy {
    max-width: 42rem;
  }

  .wellness__title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: clamp(1.9rem, 3.9vw, 3.25rem);
    line-height: 1.03;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .wellness__lead {
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .wellness__note {
    margin-top: var(--space-5);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-brass);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .wellness__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4) var(--space-6);
  }

  @media (min-width: 640px) {
    .wellness__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .wellness__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .wellness__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: var(--color-accent);
    background: var(--color-accent-faded);
    border-radius: var(--radius-full);
  }

  .wellness__features strong,
  .wellness__features small {
    display: block;
  }

  .wellness__features strong {
    font-family: var(--font-grotesk);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .wellness__features small {
    margin-top: 3px;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .wellness__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .wellness__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .wellness__link:hover {
    text-decoration: underline;
  }

  /* -------------------------------------------------------------- Mosaico */

  .wellness__gallery {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: clamp(9rem, 16vw, 14rem);
    gap: var(--space-3);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 640px) {
    .wellness__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wellness__shot--big {
      grid-column: span 2;
      grid-row: span 2;
    }

    .wellness__shot--wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .wellness__gallery {
      grid-auto-rows: clamp(10rem, 22vw, 15rem);
    }
  }

  @media (min-width: 1024px) {
    .wellness__gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(10rem, 13vw, 14rem);
    }

    .wellness__shot--big {
      grid-column: span 2;
      grid-row: span 2;
    }

    .wellness__shot--wide {
      grid-column: span 2;
    }
  }

  .wellness__shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-bg-muted);
  }

  .wellness__shot :global(img) {
    transition: transform var(--duration-slower) var(--ease-out);
  }

  .wellness__shot:hover :global(img) {
    transform: scale(1.04);
  }

  .wellness__shot::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, rgba(6, 14, 11, 0.72), transparent);
    pointer-events: none;
  }

  .wellness__caption {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-3);
    z-index: 1;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 2px rgba(6, 14, 11, 0.6);
  }

  @media (min-width: 360px) and (max-width: 639px) {
    .wellness__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 12rem;
    }

    .wellness__shot--big,
    .wellness__shot--wide {
      grid-column: span 2;
    }

    .wellness__shot--big {
      grid-row: span 2;
    }

    .wellness__caption {
      left: var(--space-3);
      bottom: var(--space-2);
    }
  }

  @media (max-width: 359px) {
    .wellness__gallery {
      grid-auto-rows: 13rem;
    }

    .wellness__caption {
      left: var(--space-3);
      bottom: var(--space-2);
    }
  }
</style>

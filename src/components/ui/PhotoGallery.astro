---
/**
 * PhotoGallery — mosaico de fotos que se abren en una galería a pantalla completa.
 *
 * POR QUÉ `<dialog>` Y NO UN DIV PROPIO
 *
 * El elemento nativo `dialog` con `showModal()` ya resuelve lo que cuesta acertar
 * a mano: atrapa el foco dentro, cierra con Escape, deja el resto de la página
 * inerte para los lectores de pantalla y devuelve el foco al elemento que lo
 * abrió. Reproducir eso con un div es donde se rompe la accesibilidad.
 *
 * QUÉ PASA SIN JAVASCRIPT
 *
 * El mosaico son botones con `data-full`, así que sin JS no hacen nada. Para que
 * la foto siga siendo accesible, cada botón envuelve la imagen y el script
 * mejora el conjunto: sin él se ven las fotos, que es lo importante.
 *
 * CÓMO SE CONSTRUYE
 *
 * Cada hueco lleva un `span` que decide su tamaño en el mosaico. Las fotos del
 * propietario vienen apaisadas y verticales mezcladas, así que el span se elige
 * por la proporción de cada archivo: las verticales van a huecos altos y las
 * apaisadas a los anchos, para que `object-fit: cover` recorte lo menos posible.
 *
 * Props:
 *   photos — { src, full?, alt, span? }
 *   label  — título accesible de la galería
 *   closeLabel, prevLabel, nextLabel — textos de los controles
 */
interface GalleryPhoto {
  src: string;
  /** Versión grande para la galería; por defecto la mayor del srcset */
  full?: string;
  alt: string;
  span?: "big" | "tall" | "wide";
}

interface Props {
  photos: GalleryPhoto[];
  /**
   * `src` de fotos que NO se renderizan en el mosaico pero SÍ forman parte de la
   * galería. Útil para fotos técnicas (planos, mapas) que ensucian el grid
   * visual pero tienen sentido dentro del lightbox cuando el cliente está
   * mirando las fotos del complejo.
   *
   * Las fotos ocultas deben estar también en `photos` — esta lista actúa
   * como filtro sobre `photos` para el render del grid; el lightbox y la
   * navegación con flechas las siguen mostrando.
   */
  hiddenFromGrid?: string[];
  label: string;
  closeLabel: string;
  prevLabel: string;
  nextLabel: string;
  counterLabel?: string;
}

const { photos, hiddenFromGrid = [], label, closeLabel, prevLabel, nextLabel, counterLabel } = Astro.props;

/** Id único si hay dos galerías en la misma página. */
const uid = Math.random().toString(36).slice(2, 8);

/**
 * Fotos que SÍ van al mosaico: todas menos las marcadas como `hiddenFromGrid`.
 * La galería (lightbox) sigue trabajando con `photos` completa, así que las
 * ocultas del grid son visibles al abrir cualquier foto y navegar con flechas.
 */
const hiddenSet = new Set(hiddenFromGrid);
const visiblePhotos = photos.filter((p) => !hiddenSet.has(p.src));

/**
 * Mapa de "índice en el array completo" para cada foto visible, así el botón
 * que abre el lightbox conoce su posición real dentro de `photos` (no de
 * `visiblePhotos`). Si esto falla, el contador y las flechas se desincronizan
 * al pasar de una foto visible a una oculta.
 */
const originalIndex = new Map<string, number>();
photos.forEach((p, i) => originalIndex.set(p.src, i));

/**
 * En móvil la retícula es de dos columnas, así que un número IMPAR de fotos deja
 * media fila vacía al final. Con 15 fotos pasa. En vez de dejar el hueco, la
 * última foto ocupa las dos columnas: cierra la retícula y se ve como una banda
 * final deliberada, no como un descuadre.
 *
 * Solo aplica por debajo de 768 px; en escritorio la composición es explícita
 * foto por foto.
 */
const cerrarEnMovil = visiblePhotos.length % 2 === 1;
---

<div class="gal" data-gallery>
  <ul class:list={["gal__mosaic", cerrarEnMovil && "gal__mosaic--cierra-impar"]} role="list">
    {visiblePhotos.map((photo) => (
      <li class:list={["gal__tile", photo.span && `gal__tile--${photo.span}`]} data-reveal>
        <button
          class="gal__btn"
          type="button"
          data-gal-open
          data-full={photo.full ?? `/assets/responsive/assets/facilities/${photo.src.replace(/^.*\//, "").replace(/\.webp$/, "")}-1400.webp`}
          data-alt={photo.alt}
          aria-label={photo.alt}
        >
          <img
            class="gal__img"
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="gal__zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5M11 8v6M8 11h6"></path>
            </svg>
          </span>
        </button>
      </li>
    ))}
  </ul>

  <!--
    BOTONES "FANTASMA" PARA LAS FOTOS OCULTAS DEL GRID.

    Cada foto marcada como `hiddenFromGrid` genera aquí un `<button>` con la
    misma información (`data-full`, `data-alt`) que un botón visible. CSS los
    esconde (`width: 0; height: 0; overflow: hidden`). El script los cuenta
    igual que a los visibles dentro de `[data-gallery]`, así que abrir
    cualquier foto del mosaico y navegar con flechas muestra las ocultas.

    Sin esto, las fotos marcadas como "no en el grid" no podrían abrirse:
    el script solo conoce las que tienen botón.
  -->
  <div class="gal__ghosts" aria-hidden="true">
    {photos.map((photo) => hiddenSet.has(photo.src) && (
      <button
        type="button"
        data-gal-open
        data-full={photo.full ?? `/assets/responsive/assets/facilities/${photo.src.replace(/^.*\//, "").replace(/\.webp$/, "")}-1400.webp`}
        data-alt={photo.alt}
        tabindex="-1"
      ></button>
    ))}
  </div>

  <dialog class="gal__dialog" data-gal-dialog aria-label={label}>
    <div class="gal__stage">
      <img class="gal__large" data-gal-large src="" alt="" />

      <button class="gal__ctl gal__ctl--close" type="button" data-gal-close aria-label={closeLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <button class="gal__ctl gal__ctl--prev" type="button" data-gal-prev aria-label={prevLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>

      <button class="gal__ctl gal__ctl--next" type="button" data-gal-next aria-label={nextLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <p class="gal__caption" data-gal-caption></p>
    {counterLabel && <p class="gal__counter" data-gal-counter></p>}
  </dialog>
</div>

<style>
  /* ------------------------------------------------------------- Mosaico */

  /*
   * Los botones "fantasma" son la puerta de entrada al lightbox para las
   * fotos ocultas del grid (planos, mapas, etc.). No se ven, no se cliquean,
   * no ocupan sitio. Solo existen para que el script los pueda encontrar
   * dentro de `[data-gallery]` y los incluya al iterar con flechas.
   */
  .gal__ghosts {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    pointer-events: none;
  }

  .gal__mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .gal__mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 11rem;
    }
  }

  .gal__tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-bg-muted);
    /* En móvil todos los huecos son iguales: el mosaico necesita la rejilla de
       escritorio para que los spans tengan sentido. */
    aspect-ratio: 4 / 3;
  }

  /*
   * Número impar de fotos: la última ocupa las dos columnas de móvil.
   *
   * Sin esto queda media fila vacía al final del mosaico. Con la última foto a
   * doble ancho la retícula cierra y el remate se lee como una banda final, que es
   * lo que hace la foto del atardecer en el lago.
   */
  .gal__mosaic--cierra-impar > .gal__tile:last-child {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 768px) {
    /*
     * RETÍCULA DE 6 FOTOS, SIN HUECOS.
     *
     * El cliente pidió que SOLO las 6 primeras fotos del set sean visibles
     * en el grid. El resto viven en el array como fotos ocultas y se
     * acceden desde el lightbox (botones fantasma + flechas).
     *
     * Composición, 12 cols × 4 filas = 48 celdas:
     *
     *   row 1-2:  (1) big cols 1-6   · (2) tall cols 7-9  · (3) tall cols 10-12
     *   row 3:    (4) wide cols 1-6   · (5) wide cols 7-12
     *             (la fila 3 la cierra la foto 4 y la 5 wide 6×1 cubre cols 7-12)
     *   row 4:    (6) wide cols 1-12 (banda final)
     *
     * Cuenta: 1×12 (big) + 2×6 (tall, 3×2 = 6 c/u) + 1×6 (wide 6×1) +
     *         1×6 (wide 6×1) + 1×12 (wide 12×1) = 12 + 12 + 6 + 6 + 12 = 48.
     *
     * TAMAÑOS Y PROPORCIONES (contenedor de 1144 px, filas de 13rem = 208 px)
     *
     *   big  6×2 → 566×428 px (1,32)   la destacada
     *   tall 3×2 → 277×428 px (0,65)   las verticales (0,75 nativo)
     *   wide 6×1 → 566×208 px (2,72)   las apaisadas
     *
     * El resto de fotos del array (8 + 1 plano) existen en `hiddenFromGrid`
     * y solo son accesibles desde el lightbox. El contador refleja el total
     * real (p.ej. "3 / 15").
     */
    .gal__mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: repeat(4, 13rem);
      align-items: stretch;
    }

    .gal__tile {
      aspect-ratio: auto;
    }

    /* fila 1-2: big + dos verticales flanqueando */
    .gal__tile:nth-child(1) { grid-area: 1 / 1  / span 2 / span 6; }  /* big  */
    .gal__tile:nth-child(2) { grid-area: 1 / 7  / span 2 / span 3; }  /* tall */
    .gal__tile:nth-child(3) { grid-area: 1 / 10 / span 2 / span 3; }  /* tall */
    /* fila 3: dos bandas apaisadas */
    .gal__tile:nth-child(4) { grid-area: 3 / 1  / span 1 / span 6; }  /* wide */
    .gal__tile:nth-child(5) { grid-area: 3 / 7  / span 1 / span 6; }  /* wide */
    /* fila 4: banda ancha que cierra la retícula */
    .gal__tile:nth-child(6) { grid-area: 4 / 1  / span 1 / span 12; }  /* wide */
  }

  .gal__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gal__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  .gal__btn:hover .gal__img,
  .gal__btn:focus-visible .gal__img {
    transform: scale(1.04);
  }

  /* Señal de que la foto se puede abrir */
  .gal__zoom {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: #fff;
    background: rgba(6, 14, 11, 0.6);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .gal__zoom svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .gal__btn:hover .gal__zoom,
  .gal__btn:focus-visible .gal__zoom {
    opacity: 1;
  }

  /* ------------------------------------------------------------- Galería */

  .gal__dialog {
    width: min(96vw, 1400px);
    max-width: none;
    max-height: 96vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .gal__dialog::backdrop {
    background: rgba(6, 14, 11, 0.92);
    backdrop-filter: blur(6px);
  }

  .gal__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /*
   * La foto se limita por alto y por ancho (`max-height` + `object-fit`) para que
   * quepa entera: en una galería lo que no puede pasar es recortar la imagen que
   * el usuario acaba de pedir ver.
   */
  .gal__large {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 82vh;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background: var(--color-bg-inverse);
  }

  .gal__caption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--text-sm);
    color: #fff;
    max-width: none;
  }

  .gal__counter {
    margin-top: var(--space-1);
    text-align: center;
    font-family: var(--font-grotesk);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--on-dark-text-muted);
    max-width: none;
  }

  .gal__ctl {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #fff;
    background: rgba(6, 14, 11, 0.62);
    border: 1px solid var(--on-dark-border);
    border-radius: var(--radius-full);
    backdrop-filter: blur(10px);
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .gal__ctl:hover {
    background: rgba(6, 14, 11, 0.85);
  }

  .gal__ctl svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .gal__ctl--close {
    /*
     * Dentro del lienzo, no fuera: con `top` negativo el botón se salía de la
     * ventana y quedaba cortado. Pegado a la esquina superior derecha de la foto
     * siempre está visible, y con el fondo oscuro se lee bien sobre cualquier
     * imagen.
     */
    top: var(--space-3);
    right: var(--space-3);
  }

  .gal__ctl--prev {
    left: calc(-1 * var(--space-3));
  }

  .gal__ctl--next {
    right: calc(-1 * var(--space-3));
  }

  @media (max-width: 767px) {
    /* En móvil los controles laterales se solaparían con la foto */
    .gal__ctl--prev {
      left: var(--space-2);
    }

    .gal__ctl--next {
      right: var(--space-2);
    }

    .gal__ctl--close {
      top: calc(-1 * var(--space-9));
    }
  }
</style>

<script>
  /**
   * Galería: abre la foto en un diálogo modal y permite recorrerlas.
   *
   * Se inicializa por cada `[data-gallery]`, no sobre el documento, para que
   * pueda haber más de una galería en la misma página sin que se pisen.
   */
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((galeria) => {
    const dialog = galeria.querySelector<HTMLDialogElement>("[data-gal-dialog]");
    const large = galeria.querySelector<HTMLImageElement>("[data-gal-large]");
    const caption = galeria.querySelector<HTMLElement>("[data-gal-caption]");
    const counter = galeria.querySelector<HTMLElement>("[data-gal-counter]");
    const botones = Array.from(galeria.querySelectorAll<HTMLButtonElement>("[data-gal-open]"));

    if (!dialog || !large || botones.length === 0) return;

    let actual = 0;

    /** Nombre del idioma para el contador ("3 / 12"). */
    const total = botones.length;

    const mostrar = (indice: number) => {
      actual = (indice + total) % total;
      const boton = botones[actual];
      const src = boton.dataset.full ?? "";
      const alt = boton.dataset.alt ?? "";

      large.src = src;
      large.alt = alt;
      if (caption) caption.textContent = alt;
      if (counter) counter.textContent = `${actual + 1} / ${total}`;

      // Precarga la siguiente: al pasar de foto no se ve el hueco en blanco
      const siguiente = botones[(actual + 1) % total];
      if (siguiente?.dataset.full) new Image().src = siguiente.dataset.full;
    };

    botones.forEach((boton, indice) => {
      boton.addEventListener("click", () => {
        mostrar(indice);
        // `showModal` es lo que da trampa de foco y cierre con Escape
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
      });
    });

    galeria.querySelector("[data-gal-close]")?.addEventListener("click", () => dialog.close());
    galeria.querySelector("[data-gal-prev]")?.addEventListener("click", () => mostrar(actual - 1));
    galeria.querySelector("[data-gal-next]")?.addEventListener("click", () => mostrar(actual + 1));

    // Clic en el fondo (fuera de la foto y de los controles) cierra
    dialog.addEventListener("click", (evento) => {
      if (evento.target === dialog) dialog.close();
    });

    // Flechas del teclado mientras la galería está abierta
    dialog.addEventListener("keydown", (evento) => {
      if (evento.key === "ArrowLeft") {
        evento.preventDefault();
        mostrar(actual - 1);
      } else if (evento.key === "ArrowRight") {
        evento.preventDefault();
        mostrar(actual + 1);
      }
    });

    // Al cerrar se suelta la imagen grande para no retener memoria
    dialog.addEventListener("close", () => {
      large.removeAttribute("src");
      large.alt = "";
    });
  });
</script>

---
/**
 * BaseLayout — armazón global del sitio.
 *
 * Responsabilidades:
 *   - Cargar el sistema de diseño (tokens, base, tipografía, layout, componentes)
 *   - Meta tags, canonical y hreflang correctos por idioma
 *   - Datos estructurados JSON-LD (Organización + Alojamiento + WebSite + página)
 *   - Preload de la imagen LCP (evita el retraso del elemento más grande)
 *   - Animaciones de aparición y comportamiento de navbar (un único script)
 */
import "~/styles/global.css";

import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import MobileCTA from "~/components/layout/MobileCTA.astro";
import { type Locale, getLocaleFromUrl, t, canonicalPath, localeLink } from "~/lib/i18n";
import { localeMeta } from "~/data/locales";
import {
  buildTitle,
  buildCanonical,
  buildHreflangLinks,
  buildOgTags,
  buildLodgingBusinessSchema,
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "~/lib/seo";
import { site } from "~/data/site";

interface Props {
  title: string;
  description: string;
  /**
   * Ruta canónica en polaco de esta página (ej. "/cennik/").
   * Es la base para hreflang: sin ella, /en/ y /de/ generarían alternates
   * apuntando a URLs en polaco.
   */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  schema?: object | object[];
  bodyClass?: string;
  /** Imagen a precargar (LCP). Ruta pública. */
  preloadImage?: string;
  /** Oculta la barra CTA móvil (páginas con formulario propio) */
  hideMobileCta?: boolean;
}

const {
  title,
  description,
  canonicalPath: canonicalPathProp,
  ogImage,
  ogType,
  noindex = false,
  schema,
  bodyClass,
  preloadImage,
  hideMobileCta = false,
} = Astro.props;

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);

/** Ruta canónica: la declarada por la página o, si no, la derivada de la URL. */
const refPath = canonicalPathProp ?? canonicalPath(Astro.url);

const fullTitle = buildTitle(title);
const canonical = buildCanonical(refPath, locale);
const hreflangs = buildHreflangLinks(refPath, locale);
const ogTags = buildOgTags({ title: fullTitle, description, ogImage, ogType }, locale, canonical);

const baseSchemas: object[] = [
  buildOrganizationSchema(locale),
  buildLodgingBusinessSchema(locale),
  buildWebSiteSchema(locale),
];

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [...baseSchemas, ...pageSchemas];

---

<!doctype html>
<html lang={localeMeta[locale].hreflang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Marca el documento como "con JS" antes del primer pintado. Las animaciones
      de aparición solo se activan con esta clase, así que sin JavaScript (o si
      el script falla) la página se muestra completa en lugar de en blanco.
    -->
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <link rel="canonical" href={canonical} />

    {hreflangs.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}

    <!--
      Favicon: un único archivo, /favicon.png (el isotipo de la marca).
      Antes había tres fuentes distintas (favicon.svg, favicon.ico y
      /assets/favicon.png), lo que daba resultados inconsistentes entre
      navegadores. Ahora todos los tamaños apuntan al mismo PNG.
    -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />

    <!-- Color de barra del navegador móvil -->
    <meta name="theme-color" content="#0e1a15" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Preload de la imagen LCP -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Geolocalización / negocio local -->
    <meta name="geo.region" content="PL-WN" />
    <meta name="geo.placename" content={site.address.locality} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <!-- Open Graph -->
    {ogTags.map((tag) => <meta property={tag.property} content={tag.content} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={ogImage?.startsWith("http") ? ogImage : `${site.url}${ogImage || "/og-default.jpg"}`}
    />

    <!-- Datos estructurados -->
    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {!hideMobileCta && <MobileCTA />}

    <slot name="end" />

    <script>
      /* ---------------------------------------------------------------------
         Un solo script para todo el comportamiento global:
         1. Aparición de bloques al hacer scroll (IntersectionObserver)
         2. Sustitución de imagen por su variante correcta ya soportada
         3. Envío de formularios con estado de carga
         --------------------------------------------------------------------- */

      // 1. Reveal
      const revealables = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (revealables.length > 0) {
        if (!("IntersectionObserver" in window)) {
          revealables.forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
          );
          revealables.forEach((el) => observer.observe(el));
        }
      }

      // 2. Estado de carga en formularios (evita doble envío)
      document.querySelectorAll<HTMLFormElement>("[data-booking-form]").forEach((form) => {
        form.addEventListener("submit", () => {
          const button = form.querySelector<HTMLButtonElement>("[type=submit]");
          if (button && form.checkValidity()) {
            button.classList.add("btn--loading");
            button.setAttribute("aria-busy", "true");
          }
        });
      });
    </script>
  </body>
</html>

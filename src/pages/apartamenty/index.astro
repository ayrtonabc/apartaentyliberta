---
/**
 * /apartamenty/ — listado completo (polaco).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ApartmentsIndex from "~/components/sections/ApartmentsIndex.astro";
import { type Locale, t } from "~/lib/i18n";
import { apartments } from "~/data/apartments";
import { buildApartmentListSchema, buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "pl";
const tr = t(locale);

const schemas = [
  buildApartmentListSchema(
    apartments.map((a) => ({
      name: a.names.pl,
      canonicalPath: `/apartamenty/${a.slugs.pl}/`,
    })),
    locale,
  ),
  buildBreadcrumbSchema(
    [
      { name: tr.nav.home, path: "/" },
      { name: tr.nav.apartments, path: "/apartamenty/" },
    ],
    locale,
  ),
];

export const prerender = true;
---

<BaseLayout
  title="Apartamenty nad Jeziorem Szeląg Wielki"
  description="Cztery apartamenty 80 m² nad Jeziorem Szeląg w Starych Jabłonkach: 3 sypialnie, prywatna balia góralska, zadaszony taras z grillem, klimatyzacja. Identyczny standard, różne widoki."
  canonicalPath="/apartamenty/"
  ogImage="/og-apartments.jpg"
  preloadImage="/assets/apartments/liberta-ii/exterior-dzien.jpg"
  schema={schemas}
>
  <ApartmentsIndex locale={locale} />
</BaseLayout>

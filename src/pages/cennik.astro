---
/**
 * /cennik/ — precios (polaco).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import PricingPage from "~/components/sections/PricingPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "pl";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.pricing.title, path: "/cennik/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Cennik apartamentów nad Jeziorem Szeląg"
  description="Przejrzysty cennik Apartamentów Liberta: od 700 zł za noc w sezonie niskim, 900 zł w sezonie wysokim. W cenie balia góralska, drewno, parking, WiFi i Netflix. Zniżki 5% od 7 nocy."
  canonicalPath="/cennik/"
  ogImage="/og-terrace.jpg"
  schema={schema}
>
  <PricingPage locale={locale} />
</BaseLayout>
---
/**
 * /de/attraktionen/ — atractivos y entorno (alemán).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import AttractionsPage from "~/components/sections/AttractionsPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "de";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.nav.attractions, path: "/atrakcje/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Unternehmungen in Masuren bei Stare Jabłonki"
  description="Der Oberländische Kanal mit seinen Schiefen Ebenen, Bunker, das Schlachtfeld bei Grunwald, Kanutouren, Wasserskilift, Golfplätze und Reiten — alles innerhalb von 30 Minuten von Apartamenty Liberta."
  canonicalPath="/atrakcje/"
  ogImage="/og-attractions.jpg"
  schema={schema}
>
  <AttractionsPage locale={locale} />
</BaseLayout>
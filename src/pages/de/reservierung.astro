---
/**
 * /de/reservierung/ — reserva (alemán).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import BookingPage from "~/components/sections/BookingPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "de";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.nav.booking, path: "/rezerwacja/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Buchung über Booking.com — Apartamenty Liberta"
  description="Buchen Sie Apartamenty Liberta über Booking.com: aktuelle Termine, Preise und Buchungsbestätigung. Sichere Zahlung und Gästebewertungen. Bei Fragen direkt kontaktieren."
  canonicalPath="/rezerwacja/"
  ogImage="/og-terrace.jpg"
  schema={schema}
>
  <BookingPage locale={locale} />
</BaseLayout>
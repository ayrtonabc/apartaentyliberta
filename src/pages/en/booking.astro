---
/**
 * /en/booking/ — reserva (inglés).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import BookingPage from "~/components/sections/BookingPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "en";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.nav.booking, path: "/rezerwacja/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Book via Booking.com — Apartamenty Liberta"
  description="Book Apartamenty Liberta on Booking.com: current dates, prices and booking confirmation. Secure payment and guest reviews. Contact us directly with any questions."
  canonicalPath="/rezerwacja/"
  ogImage="/og-terrace.jpg"
  schema={schema}
>
  <BookingPage locale={locale} />
</BaseLayout>
---
/**
 * /en/booking/results/ — compatibility with old search links.
 * Forwards dates and guests to Booking.com; no local availability engine.
 */
import { bookingUrl } from "~/data/booking";

export const prerender = false;

const params = Astro.url.searchParams;
const guests = Number(params.get("group_adults") ?? params.get("guests") ?? 0);

return Astro.redirect(
  bookingUrl("en", {
    checkIn: params.get("checkin") ?? params.get("checkIn") ?? undefined,
    checkOut: params.get("checkout") ?? params.get("checkOut") ?? undefined,
    guests: Number.isFinite(guests) && guests > 0 ? guests : undefined,
  }),
  302,
);
---

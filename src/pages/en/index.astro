---
/**
 * English homepage.
 * El cuerpo es el mismo componente que la home polaca; solo cambia el idioma.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import HomeContent from "~/components/sections/HomeContent.astro";
import { type Locale } from "~/lib/i18n";
import { buildFaqSchema, buildVideoListSchema } from "~/lib/seo";
import { getFaq } from "~/data/faq";

const locale: Locale = "en";
// Solo las 6 preguntas visibles en la home: el schema no debe declarar más.
const faqSchema = buildFaqSchema(getFaq(locale).slice(0, 6));
const videoSchema = buildVideoListSchema(locale);

export const prerender = true;
---

<BaseLayout
  title="Apartments with a private hot tub on Lake Szeląg"
  description="Four 80 m² apartments with a private hot tub and lake views, 105 m from Lake Szeląg. From 700 PLN/night. Book on Booking.com."
  canonicalPath="/"
  ogImage="/og-default.jpg"
  preloadImage="/assets/video/hero-poster.webp"
  schema={[faqSchema, videoSchema]}
>
  <HomeContent locale={locale} />
</BaseLayout>

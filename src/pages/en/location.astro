---
/**
 * /en/location/ — ubicación y cómo llegar (inglés).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import LocationPage from "~/components/sections/LocationPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "en";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.nav.location, path: "/lokalizacja/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Location — how to reach Apartamenty Liberta"
  description="Stare Jabłonki, Jarzębinowa 16 - 25 km from Olsztyn, 12 km from Ostróda and 12 km from Mazury Airport. Map, GPS coordinates and directions by car, plane and train."
  canonicalPath="/lokalizacja/"
  ogImage="/og-location.jpg"
  schema={schema}
>
  <LocationPage locale={locale} />
</BaseLayout>
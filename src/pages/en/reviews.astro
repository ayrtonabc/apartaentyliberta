---
/**
 * /en/reviews/ — opiniones de huéspedes (inglés).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ReviewsPage from "~/components/sections/ReviewsPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "en";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.reviews.eyebrow, path: "/opinie/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Guest reviews — 9.9/10 on Booking.com"
  description="Real guest reviews of Apartamenty Liberta in Stare Jabłonki: 9.9/10 on Booking.com and 5.0 on Google. See what guests say about the hot tub, the lake view and the owner's care."
  canonicalPath="/opinie/"
  ogImage="/og-terrace.jpg"
  schema={schema}
>
  <ReviewsPage locale={locale} />
</BaseLayout>
---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { type Locale, getLocaleFromUrl, t } from "~/lib/i18n";
import { site } from "~/data/site";

const locale: Locale = getLocaleFromUrl(Astro.url);
const tr = t(locale);

export const prerender = true;
---

<BaseLayout
  title="Festiwal SUP Kątno 2026"
  description="Festiwal SUP w Kątnie 2026 — 18 lipca, godz. 10:00. Sport, szkolenia, konkursy, nagrody. Zapisy 40 zł od osoby."
>
  <section class="event-hero">
    <img src="/assets/events/festiwal-sup-2026.jpg" alt="Festiwal SUP Kątno 2026" loading="eager" fetchpriority="high" width="1920" height="900" />
    <div class="event-hero__overlay"></div>
    <div class="event-hero__content">
      <div class="container container--narrow text-center">
        <span class="eyebrow" style="color: var(--color-text-inverse); opacity: 0.9;">18 lipca 2026</span>
        <h1 style="margin-top: var(--space-3); color: var(--color-text-inverse);">Festiwal SUP w Kątnie</h1>
        <p class="lead" style="margin: var(--space-6) auto 0; color: var(--color-text-inverse); opacity: 0.92;">
          Wyjątkowe wydarzenie na wodzie nad Jeziorem Szeląg Wielki — dla początkujących i zaawansowanych.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="event-info">
        <div class="event-info__item">
          <span class="event-info__label">Data</span>
          <span class="event-info__value">18 lipca 2026</span>
        </div>
        <div class="event-info__item">
          <span class="event-info__label">Start</span>
          <span class="event-info__value">10:00</span>
        </div>
        <div class="event-info__item">
          <span class="event-info__label">Miejsce</span>
          <span class="event-info__value">Jezioro Szeląg, Kątno</span>
        </div>
        <div class="event-info__item">
          <span class="event-info__label">Wpisowe</span>
          <span class="event-info__value">40 zł / osoba</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bg">
    <div class="container container--narrow">
      <h2>W programie</h2>
      <ul class="event-list">
        <li>Konkurencje sportowe na wodzie</li>
        <li>Szkolenie pływania na SUP dla początkujących</li>
        <li>Konkursy z nagrodami</li>
        <li>Integracja i wspólna zabawa w letniej atmosferze</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <header style="margin-bottom: var(--space-8); text-align: center;">
        <span class="eyebrow">Zapisy</span>
        <h2>Jak się zapisać</h2>
      </header>

      <p>Wypełnij formularz lub skontaktuj się z nami bezpośrednio. Wpisowe wynosi 40 zł.</p>

      <div class="bank-info">
        <p><strong>Beneficjent:</strong> {site.bank.accountHolder}</p>
        <p><strong>Numer konta:</strong> <span class="text-mono">82 8300 0009 0001 0240 3000 0010</span></p>
        <p><strong>Tytuł:</strong> Imię i Nazwisko, wiek zawodnika + SUP Festiwal Kątno 2026</p>
      </div>

      <p class="text-muted text-small" style="margin-top: var(--space-4);">
        Wpłat proszę dokonywać po rejestracji. Do zobaczenia na wodzie!
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .event-info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .event-info {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .event-info__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .event-info__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .event-info__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-text);
  }

  .event-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .event-list li {
    padding-left: var(--space-6);
    position: relative;
  }

  .event-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .bank-info {
    display: block;
    padding: var(--space-6);
    background: var(--color-bg-muted);
    border-radius: var(--radius-md);
    margin-top: var(--space-6);
  }

  .bank-info p {
    margin: 0 0 var(--space-2);
  }

  .bank-info p:last-child {
    margin-bottom: 0;
  }

  /* Event hero */
  .event-hero {
    position: relative;
    min-height: 60vh;
    color: var(--color-text-inverse);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .event-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0.05) 100%);
  }

  .event-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: var(--space-20);
  }
</style>

---
/**
 * Home (PL) — idioma por defecto, sin prefijo de URL.
 * El cuerpo vive en el componente compartido HomeContent para que las tres
 * versiones de idioma compartan estructura y diseño.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import HomeContent from "~/components/sections/HomeContent.astro";
import { getLocaleFromUrl } from "~/lib/i18n";
import { buildFaqSchema, buildVideoListSchema } from "~/lib/seo";
import { getFaq } from "~/data/faq";

const locale = getLocaleFromUrl(Astro.url);
// Solo las 6 preguntas visibles en la home: el schema no debe declarar más.
const faqSchema = buildFaqSchema(getFaq(locale).slice(0, 6));
const videoSchema = buildVideoListSchema(locale);

export const prerender = true;
---

<BaseLayout
  title="Apartamenty z balią i widokiem na Jezioro Szeląg"
  description="Cztery apartamenty 80 m² z prywatną balią i widokiem na Jezioro Szeląg, 105 m od wody. Od 700 zł/noc. Rezerwacja na Booking.com."
  canonicalPath="/"
  ogImage="/og-default.jpg"
  preloadImage="/assets/video/hero-poster.webp"
  schema={[faqSchema, videoSchema]}
>
  <HomeContent locale={locale} />
</BaseLayout>

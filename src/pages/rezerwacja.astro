---
/**
 * /rezerwacja/ — reserva (polaco).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import BookingPage from "~/components/sections/BookingPage.astro";
import { type Locale, t } from "~/lib/i18n";
import { buildBreadcrumbSchema } from "~/lib/seo";

const locale: Locale = "pl";
const tr = t(locale);

const schema = buildBreadcrumbSchema(
  [
    { name: tr.nav.home, path: "/" },
    { name: tr.nav.booking, path: "/rezerwacja/" },
  ],
  locale,
);

export const prerender = true;
---

<BaseLayout
  title="Rezerwacja przez Booking.com — Apartamenty Liberta"
  description="Rezerwuj Apartamenty Liberta przez Booking.com: aktualne terminy, ceny i potwierdzenie rezerwacji. Bezpieczna płatność i opinie gości. Kontakt bezpośredni w razie pytań."
  canonicalPath="/rezerwacja/"
  ogImage="/og-terrace.jpg"
  schema={schema}
  hideMobileCta={false}
>
  <BookingPage locale={locale} />
</BaseLayout>